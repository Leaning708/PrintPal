<Window x:Class="PrintPal.App.BillEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑账单"
        Width="460"
        Height="392"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,16">
            <TextBlock Text="编辑账单" Style="{StaticResource PageTitle}" />
            <TextBlock Text="账单用于区分不同客户的未结账打印；双击名称即可重新编辑" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FlatCardBorder}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="账单名称" Style="{StaticResource LabelText}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,14" />

                <TextBlock Text="备注（可选：客户电话、单号等）" Style="{StaticResource LabelText}" />
                <TextBox x:Name="NoteBox" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
