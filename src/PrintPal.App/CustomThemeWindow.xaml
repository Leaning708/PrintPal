<Window x:Class="PrintPal.App.CustomThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义配色"
        Height="840"
        Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Border Margin="12"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource PopupShadow}">
        <Grid Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏（去掉 Windows 风格顶部菜单） -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="DialogTitleText" Text="自定义配色" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="简单模式只用种子色；高级模式可以逐个 token 改颜色、导入/导出配色文件"
                               Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}"
                        Width="28" Height="28" FontSize="10"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Content="&#xE8BB;" ToolTip="关闭" Click="Cancel_Click" />
            </Grid>

            <!-- 主题名称 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="主题名称" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0" />
                <TextBox x:Name="ThemeNameBox" Width="280" Margin="12,0,0,0"
                         AutomationProperties.AutomationId="ThemeNameBox" />
                <TextBlock Text="保存后可在「设置 → 外观 → 自定义」里切换"
                           Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- 模式切换 + 导入导出 -->
            <Grid Grid.Row="2" Margin="0,12,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SimpleTabButton" Content="简单" Style="{StaticResource AccentSoftButton}"
                            Height="30" Width="76" Margin="0,0,8,0" Click="SimpleTab_Click" />
                    <Button x:Name="AdvancedTabButton" Content="高级" Style="{StaticResource SecondaryButton}"
                            Height="30" Width="76" Margin="0" Click="AdvancedTab_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="导入配色…" Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0"
                            Click="Import_Click" />
                    <Button Content="导出配色…" Style="{StaticResource SecondaryButton}" Height="30" Margin="0"
                            Click="Export_Click" />
                </StackPanel>
            </Grid>

            <!-- 简单模式 -->
            <ScrollViewer x:Name="SimplePanel" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <Border Background="{DynamicResource PageBackgroundBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="预览" Style="{StaticResource LabelText}" />
                            <Border Style="{StaticResource CardBorder}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="收银台" Foreground="{DynamicResource InkBrush}"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="账单收银与打印转发" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" Margin="0,2,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="结账" Style="{StaticResource PrimaryButton}"
                                                Height="32" Width="78" Margin="0,0,8,0" />
                                        <Button Content="挂起" Style="{StaticResource SecondaryButton}"
                                                Height="32" Width="78" Margin="0,0,8,0" />
                                        <Border Background="{DynamicResource PillNeutralBackgroundBrush}"
                                                CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="1 散客 ¥52.00"
                                                       Foreground="{DynamicResource PillNeutralTextBrush}"
                                                       FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="营业额" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                                <TextBlock Text="¥128.00" Foreground="{DynamicResource InkBrush}"
                                                           FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="账单数" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                                <TextBlock Text="12" Foreground="{DynamicResource InkBrush}"
                                                           FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="明暗模式" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LightRadio" Content="浅色" GroupName="mode" Margin="0,0,18,0"
                                             Checked="AnySetting_Changed" />
                                <RadioButton x:Name="DarkRadio" Content="深色" GroupName="mode"
                                             Checked="AnySetting_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="主色" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <WrapPanel x:Name="AccentSwatchPanel" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HEX" Style="{StaticResource LabelText}"
                                           VerticalAlignment="Center" Margin="0" />
                                <TextBox x:Name="AccentBox" Grid.Column="2" Width="120"
                                         HorizontalAlignment="Left" TextChanged="AccentBox_TextChanged" />
                            </Grid>
                            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                                       FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="页面底色" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="PageTintRadio" Content="跟随主色" GroupName="page"
                                             Margin="0,0,16,0" Checked="AnySetting_Changed" />
                                <RadioButton x:Name="PageNeutralRadio" Content="中性" GroupName="page"
                                             Margin="0,0,16,0" Checked="AnySetting_Changed" />
                                <RadioButton x:Name="PageCustomRadio" Content="自定义" GroupName="page"
                                             Checked="AnySetting_Changed" />
                                <TextBox x:Name="PageColorBox" Width="96" Margin="10,0,0,0"
                                         TextChanged="PageColorBox_TextChanged" />
                            </StackPanel>

                            <TextBlock Text="侧栏风格" Style="{StaticResource SectionTitle}" Margin="0,10,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SidebarTintRadio" Content="浅染" GroupName="sidebar"
                                             Margin="0,0,16,0" Checked="AnySetting_Changed" />
                                <RadioButton x:Name="SidebarGradientRadio" Content="渐变" GroupName="sidebar"
                                             Margin="0,0,16,0" Checked="AnySetting_Changed" />
                                <RadioButton x:Name="SidebarNeutralRadio" Content="中性" GroupName="sidebar"
                                             Checked="AnySetting_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="字体颜色" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="留空 = 按主色自动派生；填写 HEX 则覆盖对应文字 token（全文生效）"
                                       Style="{StaticResource SubtleText}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="主文字" Style="{StaticResource LabelText}"
                                           VerticalAlignment="Center" Margin="0" />
                                <TextBox x:Name="InkColorBox" Grid.Column="1" AutomationProperties.AutomationId="InkBrush"
                                         TextChanged="TextToken_TextChanged" Tag="InkBrush" />
                                <TextBlock Grid.Column="3" Text="次要文字" Style="{StaticResource LabelText}"
                                           VerticalAlignment="Center" Margin="0" />
                                <TextBox x:Name="InkSecondaryColorBox" Grid.Column="4" AutomationProperties.AutomationId="InkSecondaryBrush"
                                         TextChanged="TextToken_TextChanged" Tag="InkSecondaryBrush" />
                                <TextBlock Grid.Column="6" Text="弱化文字" Style="{StaticResource LabelText}"
                                           VerticalAlignment="Center" Margin="0" />
                                <TextBox x:Name="MutedColorBox" Grid.Column="7" AutomationProperties.AutomationId="MutedBrush"
                                         TextChanged="TextToken_TextChanged" Tag="MutedBrush" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 高级模式：逐 token 编辑 -->
            <ScrollViewer x:Name="AdvancedPanel" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="0,0,4,0">
                    <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="OverrideCountText" Text="已覆盖 0 项"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <Button Content="清空覆盖（回到种子派生）" Style="{StaticResource SecondaryButton}"
                                        Height="28" Margin="12,0,0,0" Click="ClearOverrides_Click" />
                            </StackPanel>
                            <TextBlock Text="改任意 token 都会实时预览；留空表示该 token 回到自动派生"
                                       Style="{StaticResource SubtleText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="AdvancedRowsHost" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="主色过亮/过暗会自动微调，保证按钮文字可读"
                               Style="{StaticResource SubtleText}" />
                    <TextBlock x:Name="ContrastWarningText" Foreground="{StaticResource WarningBrush}"
                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeleteThemeButton" Content="删除此主题" Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="DeleteTheme_Click" />
                    <Button Content="取消" Click="Cancel_Click" />
                    <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Margin="0" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
