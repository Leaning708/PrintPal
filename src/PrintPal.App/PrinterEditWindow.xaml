<Window x:Class="PrintPal.App.PrinterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印机设置"
        Height="880"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,16">
            <TextBlock Text="打印机设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="配置 IPP 或 Raw 9100 网络打印机，以及它的打印能力" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="名称" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                        <TextBox x:Name="NameBox" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="协议" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                                <ComboBox x:Name="ProtocolCombo" SelectionChanged="ProtocolCombo_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="文档格式" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="FormatCombo" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="主机 / IP" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                                <TextBox x:Name="HostBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="端口" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                                <TextBox x:Name="PortBox" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="ResourcePathPanel" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource LabelText}">资源路径</TextBlock>
                            <TextBox x:Name="PathBox"
                                     ToolTip="IPP 用，例如 /ipp/print；Raw 9100 等协议不使用，可留空（默认 /ipp/print）。" />
                        </StackPanel>

                        <TextBlock Text="备注" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="NotesBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                                 Padding="10,8" VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="打印能力" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="勾选这台打印机实际能处理的纸张 / 颜色 / 单双面；勾了支持的纸张 × 颜色 × 单双面即视为全部可打。"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="纸张" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="A3Check" Content="A3" />
                            <CheckBox x:Name="A4Check" Content="A4" />
                            <CheckBox x:Name="A5Check" Content="A5" />
                        </WrapPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="颜色" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="MonoCheck" Content="黑白" />
                                    <CheckBox x:Name="ColorCheck" Content="彩色" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="单双面" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="SimplexCheck" Content="单面" />
                                    <CheckBox x:Name="DuplexCheck" Content="双面" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="检测到的能力（参考）" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                <TextBlock x:Name="DetectedText"
                                           Text="尚未检测。"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="20"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Button Content="按检测结果自动填充"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="FillFromDetected_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="选项" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <CheckBox x:Name="EnabledCheck" Content="启用这台打印机" IsChecked="True" />

                        <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="连接测试" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                <TextBlock x:Name="TestResultText"
                                           Text="尚未检测。测试会读取 IPP 打印机能力。"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="测试连接"
                    HorizontalAlignment="Left"
                    Click="Test_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="0" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
