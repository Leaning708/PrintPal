<Window x:Class="PrintPal.App.PrinterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印机"
        Height="640"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False" Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="名称" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="协议" FontWeight="SemiBold" />
            <ComboBox x:Name="ProtocolCombo" SelectionChanged="ProtocolCombo_SelectionChanged" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="主机 / IP" FontWeight="SemiBold" />
                <TextBox x:Name="HostBox" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="端口" FontWeight="SemiBold" />
                <TextBox x:Name="PortBox" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3">
            <TextBlock Text="IPP 路径" FontWeight="SemiBold" />
            <TextBox x:Name="PathBox" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="文档格式" FontWeight="SemiBold" />
            <ComboBox x:Name="FormatCombo" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <CheckBox x:Name="EnabledCheck" Content="启用" IsChecked="True" />
            <CheckBox x:Name="DefaultCheck" Content="设为默认打印机" />
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="备注" FontWeight="SemiBold" />
            <TextBox x:Name="NotesBox" Height="48" AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="7" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8" Margin="0,4,0,8">
            <TextBlock x:Name="TestResultText" Text="尚未测试连接" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
        </Border>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="测试连接" Click="Test_Click" />
            <Button Content="取消" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>

