<Window x:Class="PrintPal.App.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="400"
        Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="12"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource PopupShadow}">
        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="选择颜色" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}"
                        Width="28" Height="28" FontSize="10"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Content="&#xE8BB;" ToolTip="关闭" Click="Cancel_Click" />
            </Grid>

            <!-- 饱和度/明度方块：外面套一层页面底色，避免左上角白色和卡片融在一起 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="0,12,0,0">
                <Border Width="320" Height="180" CornerRadius="8" ClipToBounds="True"
                        BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
                    <Canvas x:Name="SvCanvas" Width="320" Height="180" Background="Transparent"
                            Focusable="False"
                            MouseLeftButtonDown="Sv_MouseDown"
                            MouseMove="Sv_MouseMove"
                            MouseLeftButtonUp="Sv_MouseUp">
                        <Rectangle x:Name="HueRect" Width="320" Height="180" />
                        <Rectangle Width="320" Height="180">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Width="320" Height="180">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse x:Name="SvCursor" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                    </Canvas>
                </Border>
            </Border>

            <!-- 色相滑条 -->
            <Border Grid.Row="2" Width="320" Height="16" CornerRadius="8" ClipToBounds="True"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,12,0,0"
                    HorizontalAlignment="Left">
                <Canvas x:Name="HueCanvas" Width="320" Height="16" Background="Transparent"
                        MouseLeftButtonDown="Hue_MouseDown"
                        MouseMove="Hue_MouseMove"
                        MouseLeftButtonUp="Hue_MouseUp">
                    <Rectangle Width="320" Height="16">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="HueCursor" Width="4" Height="16" Fill="White" RadiusX="2" RadiusY="2"
                               IsHitTestVisible="False" />
                </Canvas>
            </Border>

            <!-- 当前颜色 + HEX -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                <Border x:Name="PreviewSwatch" Width="34" Height="34" CornerRadius="8"
                        BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" />
                <TextBlock Text="HEX" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                           Margin="14,0,8,0" />
                <TextBox x:Name="HexBox" Width="120" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="PickHexBox" TextChanged="HexBox_TextChanged" />
            </StackPanel>

            <!-- 常用色：固定 10 列 × 2 行，避免出现半排缺口 -->
            <TextBlock Grid.Row="4" Text="常用" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
            <UniformGrid x:Name="PresetPanel" Grid.Row="5" Columns="10" Width="320" HorizontalAlignment="Left" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="0" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
