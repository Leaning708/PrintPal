<Window x:Class="PrintPal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPal"
        Width="1440"
        Height="900"
        MinWidth="1200"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/PrintPal.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="78"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- side navigation -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AACC5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="NavIndicator"
                                        Width="3" Height="18"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="0,2,2,0"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#182741" />
                                <Setter Property="Foreground" Value="#E8EEF9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1C2C49" />
                                <Setter TargetName="NavIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        </Style>

        <Style x:Key="MinimalIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- mode switch segmented buttons: icon glyphs styled by UpdateModeSwitchButtons -->
        <Style x:Key="ModeSwitchButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SmallModeSwitchButton" TargetType="Button" BasedOn="{StaticResource ModeSwitchButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DarkModeSwitchButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        </Style>

        <!-- reusable cells -->
        <DataTemplate x:Key="StatusPillTemplate">
            <Border x:Name="Pill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#F1F5F9"
                    CornerRadius="20"
                    Padding="9,2">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PillDot" Width="6" Height="6" Fill="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PillText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="已转发">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="在线">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="启用">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="转发中">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="待转发">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="待确认">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="未路由">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="未知">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="未测试">
                    <Setter TargetName="Pill" Property="Background" Value="#F1F5F9" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SoftMutedBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="失败">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="连接失败">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="停用">
                    <Setter TargetName="Pill" Property="Background" Value="#F1F5F9" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SoftMutedBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="JobDocumentCell">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DocumentName}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DocumentName}" />
                <TextBlock Text="{Binding UserName}"
                           Margin="0,2,0,0"
                           FontSize="10.5"
                           Foreground="{StaticResource SoftMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PrinterNameCell">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}" />
                <TextBlock Text="{Binding ProtocolText}"
                           Margin="0,2,0,0"
                           FontSize="10.5"
                           Foreground="{StaticResource SoftMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HistoryBillCell">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding BillName}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Note}"
                           Margin="0,2,0,0"
                           FontSize="10.5"
                           Foreground="{StaticResource SoftMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- 挂起账单 chip -->
        <DataTemplate x:Key="ParkedBillChipTemplate">
            <Button Style="{StaticResource ParkedBillChipStyle}"
                    Content="{Binding ChipText}"
                    ToolTip="{Binding ToolTip}"
                    Click="ResumeBill_Click" />
        </DataTemplate>

        <DataTemplate x:Key="SmallParkedBillChipTemplate">
            <Button Style="{StaticResource SmallParkedBillChipStyle}"
                    Content="{Binding ChipText}"
                    ToolTip="{Binding ToolTip}"
                    Click="ResumeBill_Click" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalChipPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="AmountCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="MutedCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FooterHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <!-- ======================================================== FULL -->
        <Grid x:Name="FullLayout" Background="{StaticResource SidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,20,0,0">
                        <Border Width="36" Height="36" Background="White" CornerRadius="10" Padding="3">
                            <Image Source="pack://application:,,,/Assets/PrintPal.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="PrintPal"
                                   Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="工作台"
                                   Margin="26,0,0,8"
                                   Foreground="#607394"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                        <ListBox x:Name="NavList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectedIndex="0"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem AutomationProperties.Name="打印记录">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8A5;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="打印记录" Style="{StaticResource NavLabel}" />
                                    <Border Grid.Column="2" Background="#22314E" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="JobsNavCountText" Text="0" Foreground="#C9D7EA" FontSize="10" />
                                    </Border>
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="历史结账">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE81C;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="历史结账" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="打印机">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE749;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="打印机" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="路由规则">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8AB;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="路由规则" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="价格表">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8C7;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="价格表" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="设置">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE713;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,0,16,16">
                        <Border Background="{StaticResource SidebarCardBrush}" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AgentStatusText"
                                               Text="打印服务运行中"
                                               Margin="8,0,0,0"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="AgentUriText"
                                           Text="—"
                                           Margin="15,5,0,0"
                                           Foreground="{StaticResource SidebarMutedBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= main -->
            <Border x:Name="MainSurface"
                    Grid.Column="1"
                    Margin="3"
                    Background="{StaticResource PageBackgroundBrush}"
                    CornerRadius="3"
                    ClipToBounds="True"
                    SizeChanged="MainSurface_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                <!-- top bar -->
                <Grid Grid.Row="0" Margin="26,0,26,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                        <TextBlock x:Name="PageTitleText" Text="打印记录" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="PageSubtitleText" Text="实时台账与转发状态" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FullModeFullButton"
                                        Style="{StaticResource ModeSwitchButton}"
                                        Content="&#xE90C;"
                                        Tag="Full"
                                        Click="FullMode_Click"
                                        ToolTip="完整模式"
                                        AutomationProperties.Name="完整模式" />
                                <Button x:Name="FullModeSimpleButton"
                                        Style="{StaticResource ModeSwitchButton}"
                                        Content="&#xEA37;"
                                        Tag="Simple"
                                        Click="SimpleMode_Click"
                                        ToolTip="简洁模式"
                                        AutomationProperties.Name="简洁模式" />
                                <Button x:Name="FullModeMinimalButton"
                                        Style="{StaticResource ModeSwitchButton}"
                                        Content="&#xE73F;"
                                        Tag="Minimal"
                                        Click="MinimalMode_Click"
                                        ToolTip="极简模式"
                                        AutomationProperties.Name="极简模式" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="FullPinButton"
                                Style="{StaticResource HeaderActionButton}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Content="&#xE718;"
                                ToolTip="置顶"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TopmostToggle_Click" />
                        <Button Style="{StaticResource WindowControlButton}"
                                Content="&#xE921;"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click"
                                ToolTip="最小化到托盘" />
                        <Button x:Name="FullMaximizeButton"
                                Style="{StaticResource WindowControlButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click"
                                ToolTip="最大化">
                            <TextBlock x:Name="FullMaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyph}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseToTray_Click"
                                ToolTip="隐藏到托盘" />
                    </StackPanel>
                </Grid>

                <!-- billing strip：只在「打印记录」页显示 -->
                <Border x:Name="BillingStrip" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="26,0,26,14" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="150">
                            <TextBlock Text="当前账单" Style="{StaticResource SubtleText}" />
                            <TextBlock x:Name="FullBillNameText"
                                       Text="客户1"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}"
                                       Margin="0,2,0,0"
                                       MaxWidth="220"
                                       TextTrimming="CharacterEllipsis"
                                       Cursor="Hand"
                                       ToolTip="双击改名"
                                       MouseLeftButtonDown="BillName_MouseLeftButtonDown" />
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="22,0,18,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FullParkedCaptionText"
                                       Grid.Column="0"
                                       Text="暂无挂起账单"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <ScrollViewer Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center">
                                <ItemsControl x:Name="FullParkedBills"
                                              ItemTemplate="{StaticResource ParkedBillChipTemplate}"
                                              ItemsPanel="{StaticResource HorizontalChipPanel}" />
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="本单合计" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="FullAmountText"
                                           Text="¥0.00"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                            <Button x:Name="FullParkButton"
                                    Content="挂起"
                                    Height="44"
                                    Width="88"
                                    Margin="0,0,8,0"
                                    ToolTip="把当前账单挂起，并给下一位客户开一张新账单"
                                    Click="ParkBill_Click" />
                            <Button x:Name="FullCheckoutButton"
                                    Content="结账"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44"
                                    Width="100"
                                    Margin="0"
                                    Click="Checkout_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- pages -->
                <Grid Grid.Row="2" Margin="26,0,26,12">
                    <!-- ================= jobs -->
                    <Grid x:Name="JobsPage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="JobDetailsSpacerColumn" Width="0" />
                            <ColumnDefinition x:Name="JobDetailsColumn" Width="0" MinWidth="0" MaxWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="StatusCombo"
                                                  Grid.Column="0"
                                                  Width="122"
                                                  Height="34"
                                                  SelectedIndex="0"
                                                  SelectionChanged="Filters_Changed">
                                            <ComboBoxItem Content="全部状态" />
                                            <ComboBoxItem Content="已转发" />
                                            <ComboBoxItem Content="失败" />
                                            <ComboBoxItem Content="待转发" />
                                            <ComboBoxItem Content="待确认" />
                                            <ComboBoxItem Content="未路由" />
