                                        <DataGridTextColumn Header="时间" Binding="{Binding TimeShortText}" Width="104" MinWidth="73" />
                                        <DataGridTemplateColumn Header="文档" Width="*" MinWidth="140" CellTemplate="{StaticResource JobDocumentCell}" />
                                        <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="44" MinWidth="36" />
                                        <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="44" MinWidth="36" />
                                        <DataGridTemplateColumn Header="金额" Width="66" MinWidth="46" HeaderStyle="{StaticResource AmountColumnHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="状态" Width="92" MinWidth="64" CellTemplate="{StaticResource StatusPillTemplate}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
