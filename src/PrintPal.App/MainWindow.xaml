                                        <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBox x:Name="HistorySearchBox"
                                                     Height="32"
                                                     Padding="33,0,10,0"
                                                     TextChanged="HistorySearch_TextChanged"
                                                     ToolTip="搜索账单名或备注" />
                                            <TextBlock Text="&#xE721;"
                                                       Style="{StaticResource IconGlyph}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SoftMutedBrush}"
                                                       HorizontalAlignment="Left"
                                                       Margin="11,0,0,0"
                                                       IsHitTestVisible="False" />
                                            <TextBlock Text="搜索账单名或备注"
                                                       Margin="33,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SoftMutedBrush}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock x:Name="HistoryCountText"
                                                       Text="共 0 条"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="&#xE72C;"
                                                    ToolTip="刷新"
                                                    Click="HistoryRefresh_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <DataGrid x:Name="HistoryGrid"
