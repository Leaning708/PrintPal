                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                        <Setter Property="ToolTip" Value="{Binding SpecText}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="56" MinWidth="44">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="56" MinWidth="44">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="金额" Width="78" MinWidth="55" HeaderStyle="{StaticResource AmountColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellText}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="120" MinWidth="84">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                        <Setter Property="ToolTip" Value="{Binding TargetText}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="状态" Width="92" MinWidth="64" CellTemplate="{StaticResource StatusPillTemplate}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Background="White" IsHitTestVisible="False" Margin="0,41,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=JobsGrid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                            <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE749;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="还没有打印记录"
                                                       Margin="0,14,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="从 WPS / Word 打印到 PrintPal 虚拟打印机，任务会自动出现在这里。"
                                                       Margin="0,6,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="JobDetailsCard" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0" Visibility="Collapsed" SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,8,10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="任务详情" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="完整计价与转发信息" Style="{StaticResource SubtleText}" Margin="8,2,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButton}"
                                                Width="30"
                                                Height="30"
                                                Content="&#xE8BB;"
                                                ToolTip="关闭详情面板"
