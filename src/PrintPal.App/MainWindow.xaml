                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="PrintersGrid" Grid.Row="0" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="名称" Width="*" MinWidth="170" CellTemplate="{StaticResource PrinterNameCell}" />
