<Window x:Class="PrintPal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPal 打印助手"
        Width="1400"
        Height="880"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PrintPal 打印助手" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="打印捕获 · 自动计价 · 路由转发 · 本地台账" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AgentStatusText" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button Content="刷新" Click="Refresh_Click" />
                    <Button Content="安装队列说明" Click="InstallHelp_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16,12,16,12" Background="Transparent" BorderThickness="0">
            <!-- ============================ Print jobs ============================ -->
            <TabItem Header="打印记录">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="今日" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="TodayText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="本周" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="WeekText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="本月" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="MonthText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="DateRangeCombo" Grid.Column="0" Width="110" SelectedIndex="0"
                                      SelectionChanged="Filters_Changed">
                                <ComboBoxItem Content="全部" />
                                <ComboBoxItem Content="今日" />
                                <ComboBoxItem Content="本周" />
                                <ComboBoxItem Content="本月" />
                            </ComboBox>

                            <ComboBox x:Name="StatusCombo" Grid.Column="1" Width="130" SelectedIndex="0"
                                      Margin="8,0,0,0" SelectionChanged="Filters_Changed">
                                <ComboBoxItem Content="全部状态" />
                                <ComboBoxItem Content="已转发" />
                                <ComboBoxItem Content="失败" />
                                <ComboBoxItem Content="待转发" />
                                <ComboBoxItem Content="待确认" />
                                <ComboBoxItem Content="未路由" />
                                <ComboBoxItem Content="未知" />
                            </ComboBox>

                            <TextBox x:Name="SearchBox" Grid.Column="2" Width="220" Margin="8,0,0,0"
                                     TextChanged="SearchBox_TextChanged" ToolTip="搜索文档名或用户" />

                            <Button Grid.Column="3" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" />

                            <TextBlock Grid.Column="4" x:Name="FilterSummaryText" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="12,0,12,0"
                                       Foreground="{StaticResource MutedBrush}" />

                            <Button Grid.Column="5" Content="导出 CSV" Click="ExportCsv_Click" Margin="0" />
                        </Grid>
                    </Border>

                    <DataGrid x:Name="JobsGrid" Grid.Row="2" SelectionChanged="JobsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="130" />
                            <DataGridTextColumn Header="文档" Binding="{Binding DocumentName}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="纸张" Binding="{Binding PaperText}" Width="70" />
                            <DataGridTextColumn Header="颜色" Binding="{Binding ColorText}" Width="70" />
                            <DataGridTextColumn Header="单双面" Binding="{Binding DuplexText}" Width="100" />
                            <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="60" />
                            <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="60" />
                            <DataGridTextColumn Header="单价" Binding="{Binding UnitPriceText}" Width="85" />
                            <DataGridTextColumn Header="金额" Binding="{Binding AmountText}" Width="90" />
                            <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="120" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="任务详情" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="转发/重试" Style="{StaticResource PrimaryButton}" Click="RetryJob_Click" />
                                    <Button Content="选择目标转发" Click="ChooseTarget_Click" />
                                    <Button Content="打开文档" Click="OpenDoc_Click" />
                                    <Button Content="删除记录" Style="{StaticResource DangerButton}" Click="DeleteJob_Click" Margin="0" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="JobDetailsBox" Grid.Row="1" Height="150" Margin="0,8,0,0"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#F8FAFC" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ Printers ============================ -->
            <TabItem Header="打印机">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增打印机" Style="{StaticResource PrimaryButton}" Click="AddPrinter_Click" />
                            <Button Content="编辑" Click="EditPrinter_Click" />
                            <Button Content="测试连接" Click="TestPrinter_Click" />
                            <Button Content="设为默认" Click="SetDefault_Click" />
                            <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeletePrinter_Click" Margin="0" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="PrintersGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="协议" Binding="{Binding ProtocolText}" Width="90" />
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*" MinWidth="220" />
                            <DataGridTextColumn Header="格式/纸张" Binding="{Binding CapabilitiesText}" Width="*" MinWidth="180" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                            <DataGridTextColumn Header="启用" Binding="{Binding EnabledText}" Width="60" />
                            <DataGridTextColumn Header="默认" Binding="{Binding DefaultText}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="测试连接会读取 IPP 打印机能力（文档格式/纸张/颜色/双面）。"
                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ============================ Routing ============================ -->
            <TabItem Header="路由规则">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增规则" Style="{StaticResource PrimaryButton}" Click="AddRouting_Click" />
                            <Button Content="编辑" Click="EditRouting_Click" />
                            <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteRouting_Click" Margin="0" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="RoutingGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="65" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="条件" Binding="{Binding ConditionsText}" Width="2*" MinWidth="260" />
                            <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="启用" Binding="{Binding EnabledText}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="条件按 AND 组合；同类多值按 OR；空条件 = 任意。优先级越小越先匹配。"
                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ============================ Prices ============================ -->
            <TabItem Header="价格表">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存价格" Style="{StaticResource PrimaryButton}" Click="SavePrices_Click" />
                            <TextBlock Text="单位：元/张。双面价是“一张纸两面”的价格；双面奇数页最后一张按单面价。"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="PricesGrid" Grid.Row="1" IsReadOnly="False" CanUserAddRows="False"
                              AutoGenerateColumns="False" BeginningEdit="PricesGrid_BeginningEdit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="纸张" Binding="{Binding PaperDisplay}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="颜色" Binding="{Binding ColorDisplay}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="单面价 / 张" Binding="{Binding SimplexYuan, StringFormat=0.00}" Width="120" />
                            <DataGridTextColumn Header="双面价 / 张" Binding="{Binding DuplexYuan, StringFormat=0.00}" Width="120" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" />
                            <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="80" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="修改后点击“保存价格”。金额按分存储，显示为元。"
                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ============================ Settings ============================ -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="后台服务" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="IppUriText" Text="—" FontFamily="Consolas" Margin="0,2,0,8" />
                                <TextBlock x:Name="DataDirText" Text="—" FontFamily="Consolas" Margin="0,2,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="打开数据目录" Click="OpenData_Click" />
                                    <Button Content="打开日志" Click="OpenLogs_Click" />
                                    <Button Content="检查队列" Click="CheckQueue_Click" />
                                    <Button Content="复制安装命令" Click="CopyInstall_Click" Margin="0" />
                                </StackPanel>
                                <TextBlock x:Name="QueueStatusText" Text="队列状态：未检查" Margin="0,10,0,0"
                                           Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="转发" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="AutoForwardCheck" Content="捕获并计价后自动转发到路由目标"
                                          Checked="AutoForward_Changed" Unchecked="AutoForward_Changed" />
                                <TextBlock Text="关闭后只捕获/计价/路由，不自动发送；后续可在列表中人工处理。"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="AutostartCheck" Content="开机自动启动 PrintPal（当前用户）"
                                          Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                                <TextBlock Text="会写入 HKCU\Software\Microsoft\Windows\CurrentVersion\Run。"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="VersionText" Text="PrintPal 0.3.0" />
                                <TextBlock Text="本机 IPP 虚拟打印机 + PDF 页数解析 + SQLite 台账 + IPP/Raw 转发。"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText" Grid.Column="0" Text="就绪" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="PrintPal 0.3.0" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

