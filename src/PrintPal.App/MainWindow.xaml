                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="选择目标"
                                                    Margin="0,0,4,0"
                                                    Height="34"
                                                    Click="ChooseTarget_Click" />
                                            <Button Grid.Column="1" Content="打开文档"
                                                    Margin="4,0,0,0"
                                                    Height="34"
                                                    Click="OpenDoc_Click" />
                                        </Grid>
                                        <Button x:Name="MoveJobButton"
                                                Content="移到其他账单"
                                                Height="34"
                                                Margin="0,8,0,0"
                                                ToolTip="这条记录记错了账单时可以改到别的账单"
                                                Click="MoveJob_Click" />
                                        <Button Content="删除记录"
                                                Style="{StaticResource DangerButton}"
                                                Height="34"
                                                Margin="0,8,0,0"
                                                Click="DeleteJob_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= history -->
                    <!-- ================= history -->
                    <Grid x:Name="HistoryPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="HistoryDetailsSpacerColumn" Width="0" />
                            <ColumnDefinition x:Name="HistoryDetailsColumn" Width="0" MinWidth="0" MaxWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                                    <StackPanel>
                                        <TextBlock Text="已结账账单" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="按结账时间倒序" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="HistoryRangeCombo"
