                                          AutoGenerateColumns="False"
                                          BeginningEdit="PricesGrid_BeginningEdit"
                                          PreviewKeyDown="PricesGrid_PreviewKeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="纸张" Binding="{Binding PaperDisplay}" Width="*" MinWidth="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="颜色" Binding="{Binding ColorDisplay}" Width="*" MinWidth="100" IsReadOnly="True" />
                                        <DataGridTextColumn Header="单面价 / 张" Binding="{Binding SimplexYuan, StringFormat=0.00}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="双面价 / 张" Binding="{Binding DuplexYuan, StringFormat=0.00}" Width="*" MinWidth="120" />
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="110" MinWidth="77" />
                                        <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="110" MinWidth="77" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1"
                                           Text="双击金额单元格即可编辑；修改后点击“保存价格”。金额按分存储、界面按元显示，未启用的规则不参与计价。"
                                           Style="{StaticResource FooterHint}"
                                           Margin="18,8,18,2" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= settings -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,4" MaxWidth="1120" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="打印服务" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="本机 IPP 地址" Style="{StaticResource LabelText}" />
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,10">
                                            <TextBlock x:Name="IppUriText" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Text="数据目录" Style="{StaticResource LabelText}" />
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,14">
                                            <TextBlock x:Name="DataDirText" Text="—" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" />
                                        </Border>
                                        <WrapPanel>
                                            <Button Content="打开数据目录" Click="OpenData_Click" Margin="0,0,8,8" />
                                            <Button Content="打开日志" Click="OpenLogs_Click" Margin="0,0,8,8" />
                                            <Button Content="检查队列" Click="CheckQueue_Click" Margin="0,0,8,8" />
                                            <Button Content="复制安装命令" Click="CopyInstall_Click" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
                                            <TextBlock x:Name="QueueStatusText" Text="队列状态：未检查" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="转发" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="AutoForwardCheck"
                                                  Content="捕获并计价后自动转发到路由目标"
                                                  Checked="AutoForward_Changed"
                                                  Unchecked="AutoForward_Changed" />
                                        <TextBlock Text="关闭后只捕获、计价和路由，不自动发送；之后可在打印记录中人工处理。"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="AutostartCheck"
                                                  Content="开机自动启动 PrintPal（当前用户）"
                                                  Checked="Autostart_Changed"
                                                  Unchecked="Autostart_Changed" />
                                        <TextBlock Text="写入 HKCU\Software\Microsoft\Windows\CurrentVersion\Run，以 --background 启动并驻留托盘。"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="44" Height="44" Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="5">
                                                <Image Source="pack://application:,,,/Assets/PrintPal.png" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="VersionText" Text="PrintPal" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="本机虚拟打印 · 自动计价 · 台账归档"
                                                           Style="{StaticResource SubtleText}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="捕获 Windows IPP 打印任务，解析 PDF 页数，按纸张 / 颜色 / 单双面计价，并可转发到 IPP 或 Raw 9100 网络打印机。"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- status bar -->
                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,0">
                    <Grid>
                        <TextBlock x:Name="StatusBarText"
                                   Text="就绪"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusVersionText"
                                   Text="PrintPal"
                                   Style="{StaticResource SubtleText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== SIMPLE -->
        <Grid x:Name="SimpleLayout" Visibility="Collapsed" Background="{StaticResource PageBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="3">
                            <Image Source="pack://application:,,,/Assets/PrintPal.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="PrintPal" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="9,0,12,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SimpleModeFullButton"
                                        Style="{StaticResource SmallModeSwitchButton}"
                                        Content="&#xE90C;"
                                        Tag="Full"
                                        Click="FullMode_Click"
                                        ToolTip="完整模式"
                                        AutomationProperties.Name="完整模式" />
                                <Button x:Name="SimpleModeSimpleButton"
                                        Style="{StaticResource SmallModeSwitchButton}"
                                        Content="&#xEA37;"
                                        Tag="Simple"
                                        Click="SimpleMode_Click"
                                        ToolTip="简洁模式"
                                        AutomationProperties.Name="简洁模式" />
                                <Button x:Name="SimpleModeMinimalButton"
                                        Style="{StaticResource SmallModeSwitchButton}"
                                        Content="&#xE73F;"
                                        Tag="Minimal"
                                        Click="MinimalMode_Click"
                                        ToolTip="极简模式"
                                        AutomationProperties.Name="极简模式" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="SimplePinButton"
                                Style="{StaticResource HeaderActionButton}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Content="&#xE718;"
                                ToolTip="置顶"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TopmostToggle_Click" />
                        <Button Style="{StaticResource WindowControlButton}"
                                Content="&#xE921;"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click"
                                ToolTip="最小化到托盘" />
                        <Button x:Name="SimpleMaximizeButton"
                                Style="{StaticResource WindowControlButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click"
                                ToolTip="最大化">
                            <TextBlock x:Name="SimpleMaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyph}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseToTray_Click"
                                ToolTip="隐藏到托盘" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="16,14,16,0" Padding="20,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="当前账单" Style="{StaticResource SubtleText}" />
                            <TextBlock x:Name="SimpleCurrentTagText"
                                       Text="客户1"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}"
                                       Margin="0,2,0,0"
                                       Cursor="Hand"
                                       ToolTip="双击改名"
                                       MouseLeftButtonDown="BillName_MouseLeftButtonDown" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SimpleAmountText"
                                       Text="¥0.00"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <Button x:Name="SimpleParkButton"
                                    Content="挂起"
                                    Height="42"
                                    Width="88"
                                    Margin="0,0,8,0"
                                    ToolTip="把当前账单挂起，并给下一位客户开一张新账单"
                                    Click="ParkBill_Click" />
                            <Button x:Name="SimpleCheckoutButton"
                                    Content="结账" Style="{StaticResource PrimaryButton}" Height="42" Width="96" Margin="0" Click="Checkout_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SimpleParkedPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SimpleParkedCaptionText"
                                   Grid.Column="0"
                                   Text="已挂起 0"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ScrollViewer Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center">
                            <ItemsControl x:Name="SimpleParkedBills"
                                          ItemTemplate="{StaticResource ParkedBillChipTemplate}"
                                          ItemsPanel="{StaticResource HorizontalChipPanel}" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="16,14,16,12" Padding="0" SizeChanged="ClipCardCorners">
                <Grid>
                    <DataGrid x:Name="SimpleJobsGrid" Margin="0" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="文档" Width="*" MinWidth="180" CellTemplate="{StaticResource JobDocumentCell}" />
                            <DataGridTextColumn Header="规格" Binding="{Binding SpecText}" Width="158" MinWidth="111" />
                            <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="56" MinWidth="44" />
                            <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="56" MinWidth="44" />
                            <DataGridTemplateColumn Header="金额" Width="78" MinWidth="55" HeaderStyle="{StaticResource AmountColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="92" MinWidth="64" CellTemplate="{StaticResource StatusPillTemplate}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="White" IsHitTestVisible="False" Margin="0,41,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=SimpleJobsGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="等待打印任务"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="打印后会自动出现在当前账单下"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- ======================================================== MINIMAL -->
        <Border x:Name="MinimalLayout"
                Visibility="Collapsed"
                Background="#0B1322"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <Border Height="3" VerticalAlignment="Top" Background="#3B82F6" CornerRadius="14,14,0,0" />
                <Grid Margin="16,14,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="MinimalHeader_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="MinimalBillNameText"
                                       Text="客户1"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       MaxWidth="118"
                                       TextTrimming="CharacterEllipsis"
                                       Cursor="Hand"
                                       ToolTip="双击改名"
                                       MouseLeftButtonDown="BillName_MouseLeftButtonDown" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="2"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MinimalModeFullButton"
                                        Style="{StaticResource DarkModeSwitchButton}"
                                        Content="&#xE90C;"
                                        Tag="Full"
                                        Click="FullMode_Click"
                                        ToolTip="完整模式"
                                        AutomationProperties.Name="完整模式" />
                                <Button x:Name="MinimalModeSimpleButton"
                                        Style="{StaticResource DarkModeSwitchButton}"
                                        Content="&#xEA37;"
                                        Tag="Simple"
                                        Click="SimpleMode_Click"
                                        ToolTip="简洁模式"
                                        AutomationProperties.Name="简洁模式" />
                                <Button x:Name="MinimalModeMinimalButton"
                                        Style="{StaticResource DarkModeSwitchButton}"
                                        Content="&#xE73F;"
                                        Tag="Minimal"
                                        Click="MinimalMode_Click"
                                        ToolTip="极简模式"
                                        AutomationProperties.Name="极简模式" />
                            </StackPanel>
                        </Border>
                            <Button x:Name="MinimalPinButton"
                                    Style="{StaticResource DarkGhostButton}"
                                    Width="26"
                                    Height="24"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Content="&#xE718;"
                                    ToolTip="置顶"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="TopmostToggle_Click" />
                            <Button Style="{StaticResource MinimalIconButton}"
                                    Width="24" Height="24"
                                    Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Margin="4,0,0,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="CloseToTray_Click"
                                    ToolTip="隐藏到托盘" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="MinimalParkedPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MinimalParkedCaptionText"
                                   Grid.Column="0"
                                   Text="挂起 0"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ScrollViewer Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center">
                            <ItemsControl x:Name="MinimalParkedBills"
                                          ItemTemplate="{StaticResource SmallParkedBillChipTemplate}"
                                          ItemsPanel="{StaticResource HorizontalChipPanel}" />
                        </ScrollViewer>
                    </Grid>

                    <TextBlock x:Name="MinimalAmountText"
                               Grid.Row="2"
                               Text="¥0.00"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MinimalParkButton"
                                Grid.Column="0"
                                Content="挂起"
                                Height="34"
                                Margin="0"
                                ToolTip="把当前账单挂起，并给下一位客户开一张新账单"
                                Click="ParkBill_Click" />
                        <Button x:Name="MinimalCheckoutButton"
                                Grid.Column="2"
                                Content="结账"
                                Style="{StaticResource PrimaryButton}"
                                Height="34"
                                Margin="0"
                                Click="Checkout_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>


