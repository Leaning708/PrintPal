<Window x:Class="PrintPal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPal"
        Width="1400"
        Height="880"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Window.Resources>
        <Style x:Key="TagTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <!-- ======================================================== FULL -->
        <Grid x:Name="FullLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PrintPal" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="打印计费" Style="{StaticResource MutedText}" Margin="10,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentStatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}" />
                        <Button Content="+ 新标签" Style="{StaticResource PrimaryButton}" Click="AddTag_Click" Margin="0,0,6,0" />
                        <Button Content="结账" Style="{StaticResource PrimaryButton}" Click="Checkout_Click" Margin="0,0,6,0" />
                        <Button x:Name="FullPinButton" Content="置顶：关" Click="TopmostToggle_Click" />
                        <Button Content="简洁" Click="SimpleMode_Click" />
                        <Button Content="极简" Click="MinimalMode_Click" />
                        <Button Content="刷新" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前标签" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ListBox x:Name="FullTagTabs" Height="36" Width="620"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource TagTabItemStyle}"
                             DisplayMemberPath="Name"
                             SelectionChanged="TagTabs_SelectionChanged"
                             MouseDoubleClick="TagTabs_MouseDoubleClick" />
                    <Button Content="改名" Click="RenameTag_Click" Margin="8,0,0,0" />
                    <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteTag_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FullCurrentTagText" Grid.Column="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="当前标签：标签1" />
                    <TextBlock x:Name="FullAmountText" Grid.Column="1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="¥0.00" />
                </Grid>
            </Border>

            <TabControl Grid.Row="3" Margin="16,10,16,10" Background="Transparent" BorderThickness="0">
                <TabItem Header="打印记录">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DateRangeCombo" Grid.Column="0" Width="100" SelectedIndex="0" SelectionChanged="Filters_Changed">
                                    <ComboBoxItem Content="本标签" />
                                </ComboBox>
                                <ComboBox x:Name="StatusCombo" Grid.Column="1" Width="130" SelectedIndex="0" Margin="8,0,0,0" SelectionChanged="Filters_Changed">
                                    <ComboBoxItem Content="全部状态" />
                                    <ComboBoxItem Content="已转发" />
                                    <ComboBoxItem Content="失败" />
                                    <ComboBoxItem Content="待转发" />
                                    <ComboBoxItem Content="待确认" />
                                    <ComboBoxItem Content="未路由" />
                                    <ComboBoxItem Content="未知" />
                                </ComboBox>
                                <TextBox x:Name="SearchBox" Grid.Column="2" Width="220" Margin="8,0,0,0" TextChanged="SearchBox_TextChanged" ToolTip="搜索文档名" />
                                <Button Grid.Column="3" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="4" x:Name="FilterSummaryText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            </Grid>
                        </Border>

                        <DataGrid x:Name="JobsGrid" Grid.Row="1" SelectionChanged="JobsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="130" />
                                <DataGridTextColumn Header="文档" Binding="{Binding DocumentName}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="纸张" Binding="{Binding PaperText}" Width="65" />
                                <DataGridTextColumn Header="颜色" Binding="{Binding ColorText}" Width="65" />
                                <DataGridTextColumn Header="单双面" Binding="{Binding DuplexText}" Width="95" />
                                <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="55" />
                                <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="55" />
                                <DataGridTextColumn Header="金额" Binding="{Binding AmountText}" Width="85" />
                                <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="120" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="任务详情" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="转发/重试" Style="{StaticResource PrimaryButton}" Click="RetryJob_Click" />
                                        <Button Content="选择目标转发" Click="ChooseTarget_Click" />
                                        <Button Content="打开文档" Click="OpenDoc_Click" />
                                        <Button Content="删除记录" Style="{StaticResource DangerButton}" Click="DeleteJob_Click" Margin="0" />
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="JobDetailsBox" Grid.Row="1" Height="110" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="历史结账">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="HistoryGrid" Grid.Row="0" SelectionChanged="HistoryGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="结账时间" Binding="{Binding ClosedAtText}" Width="150" />
                                <DataGridTextColumn Header="标签" Binding="{Binding TagName}" Width="*" />
                                <DataGridTextColumn Header="单数" Binding="{Binding JobCount}" Width="65" />
                                <DataGridTextColumn Header="页数" Binding="{Binding TotalPages}" Width="65" />
                                <DataGridTextColumn Header="金额" Binding="{Binding AmountText}" Width="100" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="HistoryJobsGrid" Grid.Row="1" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="130" />
                                <DataGridTextColumn Header="文档" Binding="{Binding DocumentName}" Width="*" />
                                <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="60" />
                                <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="60" />
                                <DataGridTextColumn Header="金额" Binding="{Binding AmountText}" Width="90" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="打印机">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="新增打印机" Style="{StaticResource PrimaryButton}" Click="AddPrinter_Click" />
                                <Button Content="编辑" Click="EditPrinter_Click" />
                                <Button Content="测试连接" Click="TestPrinter_Click" />
                                <Button Content="设为默认" Click="SetDefault_Click" />
                                <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeletePrinter_Click" Margin="0" />
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="PrintersGrid" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="协议" Binding="{Binding ProtocolText}" Width="90" />
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*" MinWidth="220" />
                                <DataGridTextColumn Header="格式/纸张" Binding="{Binding CapabilitiesText}" Width="*" MinWidth="180" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                                <DataGridTextColumn Header="启用" Binding="{Binding EnabledText}" Width="60" />
                                <DataGridTextColumn Header="默认" Binding="{Binding DefaultText}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="测试连接会读取 IPP 打印机能力（文档格式/纸张/颜色/双面）。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </Grid>
                </TabItem>

                <TabItem Header="路由规则">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="新增规则" Style="{StaticResource PrimaryButton}" Click="AddRouting_Click" />
                                <Button Content="编辑" Click="EditRouting_Click" />
                                <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteRouting_Click" Margin="0" />
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="RoutingGrid" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="65" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="条件" Binding="{Binding ConditionsText}" Width="2*" MinWidth="260" />
                                <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="启用" Binding="{Binding EnabledText}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="条件按 AND 组合；同类多值按 OR；空条件 = 任意。优先级越小越先匹配。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </Grid>
                </TabItem>

                <TabItem Header="价格表">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存价格" Style="{StaticResource PrimaryButton}" Click="SavePrices_Click" />
                                <TextBlock Text="单位：元/张。双面价是一张纸两面的价格；双面奇数页最后一张按单面价。" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="PricesGrid" Grid.Row="1" IsReadOnly="False" CanUserAddRows="False" AutoGenerateColumns="False" BeginningEdit="PricesGrid_BeginningEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="纸张" Binding="{Binding PaperDisplay}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="颜色" Binding="{Binding ColorDisplay}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="单面价 / 张" Binding="{Binding SimplexYuan, StringFormat=0.00}" Width="120" />
                                <DataGridTextColumn Header="双面价 / 张" Binding="{Binding DuplexYuan, StringFormat=0.00}" Width="120" />
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" />
                                <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="80" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="修改后点击保存价格。金额按分存储，显示为元。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </Grid>
                </TabItem>

                <TabItem Header="设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4" MaxWidth="900" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="后台服务" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="IppUriText" Text="—" FontFamily="Consolas" Margin="0,2,0,8" />
                                    <TextBlock x:Name="DataDirText" Text="—" FontFamily="Consolas" Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="打开数据目录" Click="OpenData_Click" />
                                        <Button Content="打开日志" Click="OpenLogs_Click" />
                                        <Button Content="检查队列" Click="CheckQueue_Click" />
                                        <Button Content="复制安装命令" Click="CopyInstall_Click" Margin="0" />
                                    </StackPanel>
                                    <TextBlock x:Name="QueueStatusText" Text="队列状态：未检查" Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="转发" Style="{StaticResource SectionTitle}" />
                                    <CheckBox x:Name="AutoForwardCheck" Content="捕获并计价后自动转发到路由目标" Checked="AutoForward_Changed" Unchecked="AutoForward_Changed" />
                                    <TextBlock Text="关闭后只捕获/计价/路由，不自动发送；后续可在列表中人工处理。" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                                    <CheckBox x:Name="AutostartCheck" Content="开机自动启动 PrintPal（当前用户）" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                                    <TextBlock Text="会写入 HKCU\Software\Microsoft\Windows\CurrentVersion\Run。" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="VersionText" Text="PrintPal" />
                                    <TextBlock Text="本机 IPP 虚拟打印机 + PDF 页数解析 + SQLite 台账 + IPP/Raw 转发。" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusBarText" Grid.Column="0" Text="就绪" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="PrintPal" Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== SIMPLE -->
        <Grid x:Name="SimpleLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F172A" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PrintPal" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                    <ListBox x:Name="SimpleTagTabs" Grid.Column="1" Height="34" Margin="16,0,8,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource TagTabItemStyle}"
                             DisplayMemberPath="Name"
                             SelectionChanged="TagTabs_SelectionChanged"
                             MouseDoubleClick="TagTabs_MouseDoubleClick" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="+ 新标签" Style="{StaticResource PrimaryButton}" Click="AddTag_Click" />
                        <Button Content="结账" Style="{StaticResource PrimaryButton}" Click="Checkout_Click" />
                        <Button x:Name="SimplePinButton" Content="置顶：关" Click="TopmostToggle_Click" />
                        <Button Content="完整" Click="FullMode_Click" />
                        <Button Content="极简" Click="MinimalMode_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="SimpleCurrentTagText" Text="当前标签：标签1" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="SimpleCountText" Text="本次 0 单" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock x:Name="SimpleAmountText" Grid.Column="1" Text="¥0.00" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <DataGrid x:Name="SimpleJobsGrid" Grid.Row="2" Margin="12" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="135" />
                    <DataGridTextColumn Header="文档" Binding="{Binding DocumentName}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="60" />
                    <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="60" />
                    <DataGridTextColumn Header="金额" Binding="{Binding AmountText}" Width="100" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SimpleStatusText" Grid.Column="0" Text="就绪" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="+ 新标签" Style="{StaticResource PrimaryButton}" Click="AddTag_Click" />
                        <Button Content="结账" Style="{StaticResource PrimaryButton}" Click="Checkout_Click" />
                        <Button Content="完整" Click="FullMode_Click" />
                        <Button Content="极简" Click="MinimalMode_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== MINIMAL -->
        <Border x:Name="MinimalLayout" Visibility="Collapsed" Background="#0F172A" CornerRadius="12" Padding="16" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="MinimalHeader_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PrintPal" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="极简" Foreground="#94A3B8" FontSize="11" Margin="8,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimalPinButton" Content="置顶：开" Click="TopmostToggle_Click" />
                        <Button Content="□" Click="SimpleMode_Click" ToolTip="简洁模式" />
                        <Button Content="✕" Click="CloseToTray_Click" ToolTip="隐藏到托盘" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,10,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="MinimalTagCombo" Grid.Column="0" DisplayMemberPath="Name"
                                  SelectionChanged="MinimalTag_SelectionChanged" />
                        <Button Grid.Column="1" Content="切换" Click="SwitchNextTag_Click" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <TextBlock Text="本次金额" Foreground="#94A3B8" FontSize="12" />
                    <TextBlock x:Name="MinimalAmountText" Text="¥0.00" Foreground="White" FontSize="38" FontWeight="Bold" Margin="0,2,0,0" />
                    <TextBlock x:Name="MinimalCountText" Text="0 单" Foreground="#CBD5E1" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="结账" Style="{StaticResource PrimaryButton}" Click="Checkout_Click" MinWidth="110" />
                    <Button Content="切换标签" Click="SwitchNextTag_Click" />
                    <Button Content="简洁" Click="SimpleMode_Click" />
                    <Button Content="完整" Click="FullMode_Click" />
                </StackPanel>
