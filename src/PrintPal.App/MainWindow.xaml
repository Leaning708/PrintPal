                                            <DataGridTemplateColumn Header="结账时间" Width="100" MinWidth="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ClosedDateText}" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}" />
                                                            <TextBlock Text="{Binding ClosedTimeText}" FontSize="10.5" Foreground="{StaticResource SoftMutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="账单" Width="*" MinWidth="120" CellTemplate="{StaticResource HistoryBillCell}" />
                                            <DataGridTextColumn Header="单数" Binding="{Binding JobCount}" Width="52" MinWidth="42">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="金额" Width="82" MinWidth="57" HeaderStyle="{StaticResource AmountColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellText}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Background="White" IsHitTestVisible="False" Margin="0,41,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=HistoryGrid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                                            <TextBlock Text="没有符合条件的账单"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="结账后的账单会归档到这里；可以调整时间范围或清空搜索。"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="HistoryDetailsCard"
                                Grid.Column="2"
                                Style="{StaticResource CardBorder}"
                                Padding="0"
                                Visibility="Collapsed"
