<Window x:Class="PrintPal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPal"
        Width="1440"
        Height="900"
        MinWidth="1200"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/PrintPal.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="78"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- side navigation -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarNavTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="NavIndicator"
                                        Width="3" Height="18"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SidebarIndicatorBrush}"
                                        CornerRadius="0,2,2,0"
                                        Visibility="Collapsed" />
                                <ContentPresenter x:Name="NavContent"
                                                  Margin="14,0,12,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SidebarNavHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarCountTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SidebarNavActiveBrush}" />
                                <Setter TargetName="NavIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <!-- 侧边栏收起为图标模式：去掉内容左右留白，图标在窄栏里居中 -->
                            <DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                <Setter TargetName="NavContent" Property="Margin" Value="0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="Margin" Value="6,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
        </Style>

        <Style x:Key="MinimalIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource MinimalMutedBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MinimalChipBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- mode switch segmented buttons: icon glyphs styled by UpdateModeSwitchButtons -->
        <Style x:Key="ModeSwitchButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- 统计图切换（趋势 / 时段分布）分段按钮 -->
        <Style x:Key="ChartModeButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="SmallModeSwitchButton" TargetType="Button" BasedOn="{StaticResource ModeSwitchButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DarkModeSwitchButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- 侧栏右边缘拖动手柄：视觉上完全不可见（无线、无高亮），只保留拖动手感 -->
        <Style x:Key="SidebarSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
            <Setter Property="Width" Value="26" />
            <!-- 图标在 26px 的图标列内水平居中：收起为窄栏时正好落在栏中线 -->
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
            <Style.Triggers>
                <!-- 侧边栏收起为图标模式时隐藏菜单名称 -->
                <DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- reusable cells -->
        <DataTemplate x:Key="StatusPillTemplate">
            <!-- 方形状态标签：状态色底色 + 圆点 + 文字（不做圆角） -->
            <Border x:Name="Pill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PillNeutralBackgroundBrush}"
                    CornerRadius="0"
                    Padding="7,2">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PillDot"
                             Width="6"
                             Height="6"
                             Margin="0,0,5,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource PillNeutralTextBrush}" />
                    <TextBlock x:Name="PillText"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PillNeutralTextBrush}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="已转发">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="在线">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="启用">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="转发中">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已结账">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="当前">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="待转发">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="待确认">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="未路由">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="未知">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="未测试">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PillNeutralBackgroundBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{DynamicResource SoftMutedBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="失败">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="连接失败">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="停用">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PillNeutralBackgroundBrush}" />
                    <Setter TargetName="PillDot" Property="Fill" Value="{DynamicResource SoftMutedBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 状态药丸水平居中（文件列表用） -->
        <DataTemplate x:Key="StatusPillCenteredTemplate">
            <ContentPresenter Content="{Binding}"
                              ContentTemplate="{StaticResource StatusPillTemplate}"
                              HorizontalAlignment="Center" />
        </DataTemplate>

        <!-- 打印详情：分组标签 + 值 -->
        <Style x:Key="DetailsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <Style x:Key="DetailsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DetailsValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="DetailLineTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource DetailsLabel}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           FontFamily="{Binding FontFamily}"
                           ToolTip="{Binding ToolTip}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DetailsValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ellipsis}" Value="True">
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Width="20"
                        Height="20"
                        Margin="6,-2,0,0"
                        Padding="0"
                        FontSize="9"
                        VerticalAlignment="Top"
                        Content="&#xE8C8;"
                        Visibility="{Binding CopyVisibility}"
                        AutomationProperties.Name="复制完整内容"
                        ToolTip="复制完整内容"
                        Click="CopyDetailLine_Click" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="JobDocumentCell">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DocumentName}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DocumentName}" />
                <TextBlock Text="{Binding UserName}"
                           Margin="0,2,0,0"
                           FontSize="10.5"
                           Foreground="{DynamicResource SoftMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- 紧凑模式文档列：只显示文档名，不显示主机名，行高更紧凑 -->
        <DataTemplate x:Key="JobDocumentCellCompact">
            <TextBlock Text="{Binding DocumentName}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DocumentName}"
                       VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="PrinterNameCell">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}" />
                <TextBlock Text="{Binding ProtocolText}"
                           Margin="0,2,0,0"
                           FontSize="10.5"
                           Foreground="{DynamicResource SoftMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HistoryBillCell">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding BillName}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis" />
                <!-- 无备注时隐藏该行，账单名保持与单数/金额垂直居中 -->
                <TextBlock Text="{Binding Note}"
                           Margin="0,2,0,0"
                           FontSize="10.5"
                           Foreground="{DynamicResource SoftMutedBrush}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Note}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- 账单切换 chip：序号 + 名称 金额；当前账单高亮，点击其余 chip 切换 -->
        <DataTemplate x:Key="ParkedBillChipTemplate">
            <Button ToolTip="{Binding ToolTip}"
                    Click="SwitchBill_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ParkedBillChipStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding IndexText}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ChipText}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SmallParkedBillChipTemplate">
            <Button Content="{Binding ChipText}"
                    ToolTip="{Binding ToolTip}"
                    Click="SwitchBill_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallParkedBillChipStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <!-- 账单浮层行：序号 | 名称 | 挂起时间 | 金额（金额固定宽右对齐，各行对齐） -->
        <DataTemplate x:Key="ParkedPopupRowTemplate">
            <Button ToolTip="{Binding ToolTip}"
                    Click="SwitchBill_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ParkedPopupRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding IndexText}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2"
                               Text="{Binding ParkedTimeText}"
                               Foreground="{DynamicResource SoftMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding AmountText}"
                               Foreground="{DynamicResource InkBrush}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalChipPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- 任务列表右键菜单：操作项与打印详情一致（完整/紧凑共用） -->
        <ContextMenu x:Key="JobContextMenu">
            <MenuItem Header="转发 / 重试" Click="RetryJob_Click" />
            <MenuItem Header="选择目标" Click="ChooseTarget_Click" />
            <MenuItem Header="打开文档" Click="OpenDoc_Click" />
            <MenuItem Header="打开所在目录" Click="OpenDocFolder_Click" />
            <MenuItem Header="移到其他账单" Click="MoveJob_Click" />
            <Separator />
            <MenuItem Header="删除记录" Foreground="{StaticResource DangerBrush}" Click="DeleteJob_Click" />
        </ContextMenu>

        <Style x:Key="AmountCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style x:Key="AmountCellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource AmountCellText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CenterColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FooterHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <!-- 窗口外框：Win10 没有 DWM 阴影/圆角，用 1px 描边给出清晰窗口边界；Win11 由 DWM 负责圆角+阴影，
             这里不重复画，避免描边在圆角处被 DWM 裁掉。厚度由 MainWindow.xaml.cs 的 UpdateWindowFrame() 切换。 -->
        <Border x:Name="WindowFrame"
                BorderBrush="{DynamicResource LineStrongBrush}"
                BorderThickness="0"
                SnapsToDevicePixels="True">
            <Grid x:Name="WindowFrameInner">
        <!-- ======================================================== FULL -->
        <Grid x:Name="FullLayout" Background="{DynamicResource SidebarBrush}">
            <Grid.ColumnDefinitions>
                <!-- 侧栏宽度可拖动：最窄 64（仅图标），最宽 360 -->
                <ColumnDefinition x:Name="SidebarColumn" Width="238" MinWidth="64" MaxWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="SidebarHeaderRow" Height="72" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="SidebarLogoPanel" Grid.Row="0" VerticalAlignment="Top" Margin="20,20,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SidebarLogoIcon" Width="36" Height="36" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="3">
                                <Image Source="pack://application:,,,/Assets/PrintPal.png" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="SidebarLogoText"
                                       Grid.Column="1"
                                       Text="PrintPal"
                                       Margin="11,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SidebarTextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold" />
                        </Grid>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock x:Name="SidebarSectionTitle"
                                   Text="工作台"
                                   Margin="26,0,0,8"
                                   Foreground="{DynamicResource SidebarSectionBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                        <ListBox x:Name="NavList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectedIndex="0"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem AutomationProperties.Name="收银台">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7BF;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="收银台" Style="{StaticResource NavLabel}" />
                                    <Border x:Name="CashierNavCountBadge" Grid.Column="2" Background="{DynamicResource SidebarCountBrush}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CashierNavCountText" Text="0" Foreground="{DynamicResource SidebarCountTextBrush}" FontSize="10" />
                                    </Border>
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="历史结账">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE81C;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="历史结账" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="打印流水">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8FD;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="打印流水" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="统计">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D9;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="统计" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="打印机">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE749;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="打印机" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="路由规则">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8AB;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="路由规则" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="价格表">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8C7;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="价格表" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="设置">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE713;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource NavLabel}" />
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>

                    <StackPanel x:Name="SidebarStatusPanel" Grid.Row="2" Margin="16,0,16,16">
                        <Border Background="{DynamicResource SidebarCardBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AgentStatusText"
                                               Text="打印服务运行中"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="AgentUriText"
                                           Text="—"
                                           Margin="15,5,0,0"
                                           Foreground="{DynamicResource SidebarMutedBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 侧栏右边可拖动：拖窄到 170 以下自动收成图标模式，拖宽恢复文字。
                 GridSplitter 必须是它要调整的那个 Grid 的直接子元素，否则不生效。 -->
            <GridSplitter x:Name="SidebarSplitter"
                          Grid.Column="1"
                          Style="{StaticResource SidebarSplitterStyle}"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="拖动调整侧边栏宽度"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          DragDelta="SidebarSplitter_DragDelta"
                          DragCompleted="SidebarSplitter_DragCompleted" />

            <!-- ================= main -->
            <Border x:Name="MainSurface"
                    Grid.Column="2"
                    Margin="3"
                    Background="{DynamicResource PageBackgroundBrush}"
                    CornerRadius="3"
                    ClipToBounds="True"
                    SizeChanged="MainSurface_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                <!-- top bar -->
                <Grid Grid.Row="0" Margin="26,0,26,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                        <TextBlock x:Name="PageTitleText" Text="收银台" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="PageSubtitleText" Text="账单收银与打印转发" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FullModeFullButton"
                                        Style="{StaticResource ModeSwitchButton}"
                                        Content="&#xE90C;"
                                        Tag="Full"
                                        Click="FullMode_Click"
                                        ToolTip="完整模式"
                                        AutomationProperties.Name="完整模式" />
                                <Button x:Name="FullModeCompactButton"
                                        Style="{StaticResource ModeSwitchButton}"
                                        Content="&#xEA37;"
                                        Tag="Compact"
                                        Click="CompactMode_Click"
                                        ToolTip="紧凑模式"
                                        AutomationProperties.Name="紧凑模式" />
                                <Button x:Name="FullModeMinimalButton"
                                        Style="{StaticResource ModeSwitchButton}"
                                        Content="&#xE73F;"
                                        Tag="Minimal"
                                        Click="MinimalMode_Click"
                                        ToolTip="极简模式"
                                        AutomationProperties.Name="极简模式" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="FullPinButton"
                                Style="{StaticResource HeaderActionButton}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Content="&#xE718;"
                                ToolTip="置顶"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TopmostToggle_Click" />
                        <Button Style="{StaticResource WindowControlButton}"
                                Content="&#xE921;"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click"
                                ToolTip="最小化到托盘" />
                        <Button x:Name="FullMaximizeButton"
                                Style="{StaticResource WindowControlButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click"
                                ToolTip="最大化">
                            <TextBlock x:Name="FullMaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyph}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseToTray_Click"
                                ToolTip="隐藏到托盘" />
                    </StackPanel>
                </Grid>

                <!-- billing strip：只在「收银台」页显示。
                     「当前账单」与「未结账单」共用同一标题行，保证两个小标题水平对齐。 -->
                <Border x:Name="BillingStrip" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="26,0,26,14" Padding="18,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- MinWidth 给当前账单列留出余量，账单改名时列宽不再频繁跳动 -->
                            <ColumnDefinition Width="Auto" MinWidth="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="当前账单" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                            <Button x:Name="CopyBillFlowNoButton"
                                    Style="{StaticResource IconButton}"
                                    Width="18"
                                    Height="18"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    FontSize="8"
                                    Content="&#xE8C8;"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="复制账单流水号"
                                    ToolTip="复制账单流水号"
                                    Click="CopyBillFlowNo_Click" />
                        </StackPanel>
                        <TextBlock x:Name="FullBillNameText"
                                   Grid.Row="1" Grid.Column="0"
                                   Text="客户1"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}"
                                   Margin="0,3,0,0"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   Cursor="Hand"
                                   ToolTip="双击改名"
                                   MouseLeftButtonDown="BillName_MouseLeftButtonDown" />

                        <!-- 账单切换区（方案 B）：未结账单统一展示，chip 一行放满、
                             溢出的折叠进「+N」浮层；点击 chip/+N 行切换当前账单 -->
                        <TextBlock x:Name="FullParkedCaptionText"
                                   Grid.Row="0" Grid.Column="1"
                                   Text="未结账单"
                                   Style="{StaticResource SubtleText}"
                                   Margin="32,0,0,4"
                                   Visibility="Collapsed" />
                        <Border x:Name="FullParkedPanel"
                                Grid.Row="1" Grid.Column="1"
                                Margin="22,0,18,0"
                                Visibility="Collapsed">
                            <!-- 左右分割线：上下各缩 2.5px（共短 5px） -->
                            <Grid>
                                <Rectangle Width="1" Fill="{DynamicResource LineBrush}" HorizontalAlignment="Left" Margin="0,2.5,0,2.5" />
                                <Rectangle Width="1" Fill="{DynamicResource LineBrush}" HorizontalAlignment="Right" Margin="0,2.5,0,2.5" />
                                <Grid x:Name="FullParkedChipHost" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <!-- +N 跟随最后一个可见 chip（Auto 列贴内容），不靠右悬空 -->
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0"
                                                  x:Name="FullParkedBills"
                                                  Margin="10,2,0,2"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ItemTemplate="{StaticResource ParkedBillChipTemplate}"
                                                  ItemsPanel="{StaticResource HorizontalChipPanel}">
                                        <ItemsControl.ItemContainerStyle>
                                            <!-- 新容器默认隐藏：等溢出计算后再显示，避免重建时闪现一帧 -->
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <Button Grid.Column="1"
                                            x:Name="FullParkedOverflowButton"
                                            Content="+0"
                                            Style="{StaticResource ParkedOverflowChipStyle}"
                                            VerticalAlignment="Center"
                                            Margin="0,2,10,2"
                                            Visibility="Collapsed"
                                            ToolTip="查看全部账单"
                                            Click="ParkedOverflow_Click" />
                                </Grid>
                                <Popup x:Name="FullParkedPopup"
                                       PlacementTarget="{Binding ElementName=FullParkedPanel}"
                                       Placement="Bottom"
                                       VerticalOffset="4"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource LineStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                            Margin="0,0,14,14"
                                            MinWidth="250"
                                            MaxWidth="300"
                                            MaxHeight="330">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.18" />
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="FullParkedPopupList"
                                                          ItemTemplate="{StaticResource ParkedPopupRowTemplate}" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="本单合计" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="FullAmountText"
                                           Text="¥0.00"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                            <Button x:Name="FullParkButton"
                                    Height="44"
                                    Width="88"
                                    Margin="0,0,8,0"
                                    FontWeight="Bold"
                                    ToolTip="把当前账单挂起，并给下一位客户开一张新账单"
                                    Click="ParkBill_Click">
                                <TextBlock Text="挂&#x2002;起" FontSize="16" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="FullCheckoutButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44"
                                    Width="100"
                                    Margin="0"
                                    FontWeight="Bold"
                                    Click="Checkout_Click">
                                <TextBlock Text="结&#x2002;账" FontSize="16" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- pages -->
                <Grid Grid.Row="2" Margin="26,0,26,12">
                    <!-- ================= jobs -->
                    <Grid x:Name="JobsPage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360" />
                            <ColumnDefinition x:Name="PrintDetailsSpacerColumn" Width="0" />
                            <ColumnDefinition x:Name="PrintDetailsColumn" Width="0" MinWidth="0" MaxWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="StatusCombo"
                                                  Grid.Column="0"
                                                  Width="122"
                                                  Height="34"
                                                  SelectedIndex="0"
                                                  SelectionChanged="Filters_Changed">
                                            <ComboBoxItem Content="全部状态" />
                                            <ComboBoxItem Content="已转发" />
                                            <ComboBoxItem Content="失败" />
                                            <ComboBoxItem Content="待转发" />
                                            <ComboBoxItem Content="待确认" />
                                            <ComboBoxItem Content="未路由" />
                                            <ComboBoxItem Content="未知" />
                                        </ComboBox>
                                        <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <!-- 注意：TextBox 模板会把 Padding 双倍应用（ScrollViewer Margin + 原生文字缩进），
                                                 11 实际渲染约 23px；占位文字 Margin 22 与输入文字/光标对齐 -->
                                            <TextBox x:Name="SearchBox"
                                                     Height="34"
                                                     Padding="11,0,5,0"
                                                     TextChanged="SearchBox_TextChanged"
                                                     ToolTip="搜索文档名或用户名" />
                                            <TextBlock Text="&#xE721;"
                                                       Style="{StaticResource IconGlyph}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SoftMutedBrush}"
                                                       HorizontalAlignment="Left"
                                                       Margin="7,0,0,0"
                                                       IsHitTestVisible="False" />
                                            <TextBlock Text="搜索文档或用户"
                                                       Margin="22,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SoftMutedBrush}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <!-- 仅在「空且未聚焦」时显示，避免与输入光标重叠 -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock x:Name="FilterSummaryText"
                                                       Text="0 条"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="&#xE72C;"
                                                    ToolTip="刷新"
                                                    Click="Refresh_Click" />
                                            <Button Style="{StaticResource SubtleButton}"
                                                    Height="34"
                                                    Padding="10,0"
                                                    Margin="4,0,0,0"
                                                    Click="ExportCsv_Click"
                                                    ToolTip="导出当前筛选结果">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="导出" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <DataGrid x:Name="CashierGrid" SelectionChanged="CashierGrid_SelectionChanged"
                                              PreviewMouseLeftButtonDown="CashierGrid_PreviewMouseLeftButtonDown"
                                              PreviewMouseRightButtonUp="JobGrid_PreviewMouseRightButtonUp"
                                              ContextMenu="{StaticResource JobContextMenu}"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="文档" Width="*" MinWidth="120" CellTemplate="{StaticResource JobDocumentCell}" />
                                            <DataGridTextColumn Header="规格" Binding="{Binding SpecText}" Width="158" MinWidth="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                        <Setter Property="ToolTip" Value="{Binding SpecText}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="56" MinWidth="36" HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="56" MinWidth="36" HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="金额" Width="78" MinWidth="44" HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellTextCenter}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="120" MinWidth="66">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                        <Setter Property="ToolTip" Value="{Binding TargetText}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="状态" Width="92" MinWidth="52" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" CellTemplate="{StaticResource StatusPillCenteredTemplate}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Background="{DynamicResource CardBrush}" IsHitTestVisible="False" Margin="0,41,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=CashierGrid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                            <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE749;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="还没有打印记录"
                                                       Margin="0,14,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="从 WPS / Word 打印到 PrintPal 虚拟打印机，任务会自动出现在这里。"
                                                       Margin="0,6,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 拖拽调整打印详情宽度（宽度写入 Settings.detailsWidth，切换任务不重置） -->
                        <GridSplitter x:Name="PrintDetailsSplitter"
                                      Grid.Column="1"
                                      Width="14"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      Cursor="SizeWE"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="False"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="调整打印详情宽度"
                                      DragDelta="PrintDetailsSplitter_DragDelta"
                                      DragCompleted="PrintDetailsSplitter_DragCompleted" />

                        <Border x:Name="PrintDetailsCard" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0" Visibility="Collapsed" SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,8,10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="打印详情" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="计价与转发" Style="{StaticResource SubtleText}" Margin="8,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="0,0,4,0"
                                                    Content="&#xE8C8;"
                                                    AutomationProperties.Name="复制详情"
                                                    ToolTip="复制详情文本"
                                                    Click="CopyPrintDetails_Click" />
                                            <Button Style="{StaticResource IconButton}"
                                                    Width="30"
                                                    Height="30"
                                                    Content="&#xE8BB;"
                                                    AutomationProperties.Name="关闭打印详情"
                                                    ToolTip="关闭打印详情"
                                                    Click="ClosePrintDetails_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                    <StackPanel x:Name="PrintDetailsContent" Margin="18,14,14,16">
                                        <TextBlock Text="{Binding DocumentName}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MetaLineText}"
                                                   Style="{StaticResource SubtleText}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />

                                        <!-- 文件流水号（可复制） -->
                                        <Grid x:Name="DetailsFlowNoRow" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="流水号" Style="{StaticResource DetailsLabel}" />
                                            <TextBlock x:Name="DetailsFlowNoText"
                                                       Grid.Column="1"
                                                       FontFamily="Consolas"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource InkSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource IconButton}"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="6,-2,0,0"
                                                    Padding="0"
                                                    FontSize="9"
                                                    VerticalAlignment="Top"
                                                    Content="&#xE8C8;"
                                                    AutomationProperties.Name="复制流水号"
                                                    ToolTip="复制流水号"
                                                    Click="CopyDetailsFlowNo_Click" />
                                        </Grid>

                                        <!-- 状态 + 本任务金额 -->
                                        <Border Style="{StaticResource InsetCard}" Margin="0,12,0,0" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource StatusPillTemplate}" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AmountText}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="本任务金额"
                                                               Style="{StaticResource SubtleText}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 状态说明（失败原因等，无内容时隐藏） -->
                                        <Border Margin="0,8,0,0" Padding="10,8">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource InsetCard}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasStatusReason}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="未知">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="状态说明" Style="{StaticResource DetailsSectionTitle}" Margin="0,0,0,3" Foreground="{DynamicResource InkSecondaryBrush}" />
                                                <TextBlock Text="{Binding StatusReasonText}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource InkSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="计价" Style="{StaticResource DetailsSectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding PriceLines}"
                                                      ItemTemplate="{StaticResource DetailLineTemplate}"
                                                      Focusable="False" />

                                        <TextBlock Text="规格" Style="{StaticResource DetailsSectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding SpecLines}"
                                                      ItemTemplate="{StaticResource DetailLineTemplate}"
                                                      Focusable="False" />

                                        <TextBlock Text="转发" Style="{StaticResource DetailsSectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding ForwardLines}"
                                                      ItemTemplate="{StaticResource DetailLineTemplate}"
                                                      Focusable="False" />

                                        <TextBlock Text="文档" Style="{StaticResource DetailsSectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding DocLines}"
                                                      ItemTemplate="{StaticResource DetailLineTemplate}"
                                                      Focusable="False" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= history -->
                    <!-- ================= history -->
                    <Grid x:Name="HistoryPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="HistoryDetailsSpacerColumn" Width="0" />
                            <ColumnDefinition x:Name="HistoryDetailsColumn" Width="0" MinWidth="0" MaxWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                                    <StackPanel>
                                        <TextBlock Text="已结账账单" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="按结账时间倒序" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="HistoryRangeCombo"
                                                  Grid.Column="0"
                                                  Width="116"
                                                  Height="32"
                                                  SelectedIndex="0"
                                                  SelectionChanged="HistoryFilter_Changed">
                                            <ComboBoxItem Content="全部时间" />
                                            <ComboBoxItem Content="今天" />
                                            <ComboBoxItem Content="近 7 天" />
                                            <ComboBoxItem Content="近 30 天" />
                                        </ComboBox>

                                        <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBox x:Name="HistorySearchBox"
                                                     Height="32"
                                                     Padding="11,0,5,0"
                                                     TextChanged="HistorySearch_TextChanged"
                                                     ToolTip="搜索账单名或备注" />
                                            <TextBlock Text="&#xE721;"
                                                       Style="{StaticResource IconGlyph}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SoftMutedBrush}"
                                                       HorizontalAlignment="Left"
                                                       Margin="7,0,0,0"
                                                       IsHitTestVisible="False" />
                                            <TextBlock Text="搜索账单名或备注"
                                                       Margin="22,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SoftMutedBrush}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <!-- 仅在「空且未聚焦」时显示，避免与输入光标重叠 -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Text, ElementName=HistorySearchBox}" Value="" />
                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=HistorySearchBox}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock x:Name="HistoryCountText"
                                                       Text="共 0 条"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="&#xE72C;"
                                                    ToolTip="刷新"
                                                    Click="HistoryRefresh_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <DataGrid x:Name="HistoryGrid"
                                              SelectionChanged="HistoryGrid_SelectionChanged"
                                              PreviewMouseLeftButtonDown="HistoryGrid_PreviewMouseLeftButtonDown"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="结账时间" Width="100" MinWidth="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ClosedDateText}" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}" />
                                                            <TextBlock Text="{Binding ClosedTimeText}" FontSize="10.5" Foreground="{DynamicResource SoftMutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="账单" Width="*" MinWidth="120" CellTemplate="{StaticResource HistoryBillCell}" />
                                            <DataGridTextColumn Header="单数" Binding="{Binding JobCount}" Width="52" MinWidth="42">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="金额" Width="82" MinWidth="57" HeaderStyle="{StaticResource AmountColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellText}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Background="{DynamicResource CardBrush}" IsHitTestVisible="False" Margin="0,41,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=HistoryGrid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                                            <TextBlock Text="没有符合条件的账单"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="结账后的账单会归档到这里；可以调整时间范围或清空搜索。"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 拖拽调整账单明细宽度（宽度写入 Settings.historyDetailsWidth，切换账单不重置） -->
                        <GridSplitter x:Name="HistoryDetailsSplitter"
                                      Grid.Column="1"
                                      Width="14"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      Cursor="SizeWE"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="False"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="调整账单明细宽度"
                                      DragDelta="HistoryDetailsSplitter_DragDelta"
                                      DragCompleted="HistoryDetailsSplitter_DragCompleted" />

                        <Border x:Name="HistoryDetailsCard"
                                Grid.Column="2"
                                Style="{StaticResource CardBorder}"
                                Padding="0"
                                Visibility="Collapsed"
                                SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,8,10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="账单明细" Style="{StaticResource CardTitle}" />
                                            <TextBlock x:Name="HistorySummaryText"
                                                       Text="选择左侧账单查看其中的打印记录"
                                                       Style="{StaticResource SubtleText}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButton}"
                                                Width="30"
                                                Height="30"
                                                Content="&#xE8BB;"
                                                ToolTip="关闭账单明细"
                                                Click="CloseHistoryDetails_Click" />
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="HistoryCashierGrid" Grid.Row="1" Margin="0" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding TimeShortText}" Width="56" MinWidth="48" />
                                        <DataGridTemplateColumn Header="文档" Width="*" MinWidth="140" CellTemplate="{StaticResource JobDocumentCell}" />
                                        <DataGridTextColumn Header="规格" Binding="{Binding SpecText}" Width="150" MinWidth="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="44" MinWidth="30" />
                                        <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="44" MinWidth="30" />
                                        <DataGridTemplateColumn Header="金额" Width="66" MinWidth="46" HeaderStyle="{StaticResource AmountColumnHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="110" MinWidth="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= printers -->
                    <!-- ================= print flows -->
                    <Grid x:Name="FlowsPage" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorder}" Padding="0" SizeChanged="ClipCardCorners">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="打印流水" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="账单 / 文件的流水编号，可追溯到账单；账单被删除后仍保留快照"
                                                       Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="FlowCountText" Text="共 0 条" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                                    ToolTip="刷新流水" Click="FlowsRefresh_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <TextBox x:Name="FlowSearchBox"
                                                     Height="32"
                                                     Padding="11,0,5,0"
                                                     TextChanged="FlowSearch_TextChanged"
                                                     ToolTip="搜索流水号 / 账单 / 文档 / 目标打印机" />
                                            <TextBlock Text="&#xE721;"
                                                       Style="{StaticResource IconGlyph}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SoftMutedBrush}"
                                                       HorizontalAlignment="Left"
                                                       Margin="7,0,0,0"
                                                       IsHitTestVisible="False" />
                                            <TextBlock Text="搜索流水号 / 账单 / 文档 / 目标打印机"
                                                       Margin="22,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SoftMutedBrush}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Text, ElementName=FlowSearchBox}" Value="" />
                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FlowSearchBox}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock Grid.Column="1"
                                                   Text="双击或右键可追溯账单"
                                                   Style="{StaticResource SubtleText}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="FlowsGrid"
                                          Grid.Row="2"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HorizontalScrollBarVisibility="Auto"
                                          MouseDoubleClick="FlowsGrid_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="追溯账单" Click="FlowTrace_Click" />
                                            <MenuItem Header="复制流水号" Click="FlowCopyNo_Click" />
                                            <Separator />
                                            <MenuItem Header="删除流水"
                                                      Foreground="{StaticResource DangerBrush}"
                                                      Click="FlowDelete_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="流水号" Binding="{Binding FlowNo}" Width="184" MinWidth="150">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="文档" Binding="{Binding DocumentText}" Width="*" MinWidth="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="所属账单" Width="130" MinWidth="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BillText}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource InkSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding BillText}" />
                                                        <TextBlock Text="{Binding BillMissingText}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource DangerBrush}"
                                                                   Margin="0,1,0,0"
                                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="172" MinWidth="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding TimeText}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="金额" Width="86" MinWidth="64"
                                                                HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellTextCenter}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- 与收银台同款：色底 + 圆点 + 状态色文字 -->
                                        <DataGridTemplateColumn Header="状态" Width="86" MinWidth="64"
                                                                HeaderStyle="{StaticResource CenterColumnHeaderStyle}"
                                                                CellTemplate="{StaticResource StatusPillCenteredTemplate}" />
                                        <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="112" MinWidth="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding TargetText}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FlowPageText"
                                                   Text="第 1 / 1 页"
                                                   Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="FlowPageSizeCombo"
                                                      Width="86"
                                                      Height="28"
                                                      SelectedIndex="1"
                                                      SelectionChanged="FlowPageSize_Changed"
                                                      Margin="0,0,10,0"
                                                      ToolTip="每页条数">
                                                <ComboBoxItem Content="20 条" />
                                                <ComboBoxItem Content="50 条" />
                                                <ComboBoxItem Content="100 条" />
                                            </ComboBox>
                                            <Button x:Name="FlowPrevPageButton"
                                                    Content="上一页"
                                                    Click="FlowPrevPage_Click"
                                                    Margin="0,0,8,0" />
                                            <StackPanel x:Name="FlowPageNumbersPanel"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0" />
                                            <Button x:Name="FlowNextPageButton"
                                                    Content="下一页"
                                                    Click="FlowNextPage_Click" />
                                            <TextBlock Text="跳至"
                                                       Style="{StaticResource SubtleText}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,4,0" />
                                            <TextBox x:Name="FlowPageJumpBox"
                                                     Width="46"
                                                     Height="28"
                                                     VerticalContentAlignment="Center"
                                                     TextAlignment="Center"
                                                     ToolTip="输入页码后回车跳转"
                                                     KeyDown="FlowPageJumpBox_KeyDown" />
                                            <TextBlock Text="页"
                                                       Style="{StaticResource SubtleText}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0" />
                                            <Button Content="跳转"
                                                    Click="FlowPageJump_Click"
                                                    Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= statistics -->
                    <Grid x:Name="StatsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <!-- 每日明细/维度统计 与 统计图 等权重：窗口放大/缩小时三张卡片同步伸缩 -->
                            <RowDefinition Height="*" MinHeight="200" />
                            <RowDefinition Height="*" MinHeight="180" />
                        </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="经营统计" Style="{StaticResource CardTitle}" />
                                        <TextBlock x:Name="StatsRangeHint" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="StatsRangeCombo"
                                                  Width="118"
                                                  Height="32"
                                                  SelectedIndex="1"
                                                  SelectionChanged="StatsRange_Changed">
                                            <ComboBoxItem Content="今天" />
                                            <ComboBoxItem Content="近 7 天" />
                                            <ComboBoxItem Content="近 30 天" />
                                            <ComboBoxItem Content="全部时间" />
                                            <ComboBoxItem Content="自定义" />
                                        </ComboBox>
                                        <Button Style="{StaticResource SubtleButton}"
                                                Content="导出 CSV"
                                                Height="32"
                                                Margin="8,0,0,0"
                                                Click="StatsExport_Click" />
                                        <Button Style="{StaticResource IconButton}"
                                                Content="&#xE72C;"
                                                ToolTip="刷新统计"
                                                Margin="4,0,0,0"
                                                Click="StatsRefresh_Click" />
                                    </StackPanel>

                                    <!-- 自定义时间段：选完开始日期自动弹出结束日期选择（最长一年） -->
                                    <StackPanel x:Name="StatsCustomRangePanel"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                        <TextBlock Text="开始" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        <DatePicker x:Name="StatsStartPicker"
                                                    Width="150"
                                                    Height="30"
                                                    Margin="6,0,0,0"
                                                    SelectedDateChanged="StatsStartPicker_SelectedDateChanged" />
                                        <TextBlock Text="至" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,10,0" />
                                        <DatePicker x:Name="StatsEndPicker"
                                                    Width="150"
                                                    Height="30"
                                                    SelectedDateChanged="StatsEndPicker_SelectedDateChanged" />
                                        <TextBlock Text="最长一年（366 天）" Style="{StaticResource SubtleText}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Grid.Row="1" Columns="6" Margin="0,12,0,0">
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="营业额" Style="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="StatsRevenueText" Text="¥0.00" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="按结账时间" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="账单数" Style="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="StatsBillsText" Text="0" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="已结账" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="打印任务" Style="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="StatsJobsText" Text="0" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="按打印时间" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="页数" Style="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="StatsPagesText" Text="0" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="页 × 份" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="张数" Style="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="StatsSheetsText" Text="0" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="实际出纸" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}">
                                    <StackPanel>
                                        <TextBlock Text="客单价" Style="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="StatsAvgText" Text="¥0.00" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="营业额 / 账单数" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 统计图：趋势折线 / 时段分布 二选一（同一块位置切换）；
                                 与上面两张卡片等权重，窗口放大/缩小时一起伸缩（不再固定 300 高） -->
                            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock Text="统计图" Style="{StaticResource CardTitle}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Background="{DynamicResource ChartToggleBackgroundBrush}"
                                                    BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="StatsChartTrendButton"
                                                            Style="{StaticResource ChartModeButton}"
                                                            Content="趋势"
                                                            Tag="trend"
                                                            Click="StatsChartMode_Click" />
                                                    <Button x:Name="StatsChartHourButton"
                                                            Style="{StaticResource ChartModeButton}"
                                                            Content="时段分布"
                                                            Tag="hour"
                                                            Click="StatsChartMode_Click" />
                                                </StackPanel>
                                            </Border>
                                            <ComboBox x:Name="StatsMetricCombo"
                                                      Width="110"
                                                      Height="28"
                                                      Margin="8,0,0,0"
                                                      SelectedIndex="0"
                                                      SelectionChanged="StatsMetric_Changed">
                                                <ComboBoxItem Content="营业额" />
                                                <ComboBoxItem Content="账单数" />
                                                <ComboBoxItem Content="任务数" />
                                                <ComboBoxItem Content="页数" />
                                                <ComboBoxItem Content="张数" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,10,0,0" MinHeight="120">
                                        <Grid x:Name="StatsChartHost"
                                              Background="Transparent"
                                              SizeChanged="StatsChartHost_SizeChanged"
                                              MouseMove="StatsChartHost_MouseMove"
                                              MouseLeave="StatsChartHost_MouseLeave">
                                            <Canvas x:Name="StatsChartCanvas" ClipToBounds="True" />
                                            <TextBlock x:Name="StatsChartEmptyText"
                                                       Text="当前范围内没有数据"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}" />
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <ItemsControl x:Name="HourBars"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Visibility="Collapsed">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="34" Margin="0,0,2,0" ToolTip="{Binding ToolTip}">
                                                        <Grid Height="86">
                                                            <Border Height="{Binding BarHeight}"
                                                                    Width="18"
                                                                    CornerRadius="3"
                                                                    Background="{DynamicResource AccentSoftBrush}"
                                                                    VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding CountText}"
                                                                   FontSize="9.5"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource SoftMutedBrush}" />
                                                        <TextBlock Text="{Binding HourText}"
                                                                   FontSize="9.5"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource MutedBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <!-- 两张卡片等宽权重 -->
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Padding="16,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="每日明细" Style="{StaticResource CardTitle}" />
                                        </Border>
                                        <DataGrid x:Name="DailyStatsGrid"
                                                  Grid.Row="1"
                                                  IsReadOnly="True"
                                                  AutoGenerateColumns="False"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="1.3*" MinWidth="112" />
                                                <DataGridTextColumn Header="星期" Binding="{Binding WeekText}" Width="*" MinWidth="48"
                                                                    HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Header="营业额" Width="*" MinWidth="82"
                                                                        HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding RevenueText}" Style="{StaticResource AmountCellTextCenter}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="账单" Binding="{Binding BillCount}" Width="*" MinWidth="48"
                                                                    HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="任务" Binding="{Binding JobCount}" Width="*" MinWidth="48"
                                                                    HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="*" MinWidth="48"
                                                                    HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="张数" Binding="{Binding SheetCount}" Width="*" MinWidth="48"
                                                                    HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="1"
                                                   Text="当前范围内没有数据"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,40,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=DailyStatsGrid}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Padding="16,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="维度统计" Style="{StaticResource CardTitle}" />
                                        </Border>
                                        <DataGrid x:Name="DimensionStatsGrid"
                                                  Grid.Row="1"
                                                  IsReadOnly="True"
                                                  AutoGenerateColumns="False"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="维度" Binding="{Binding DimensionText}" Width="*" MinWidth="68" />
                                                <DataGridTextColumn Header="取值" Binding="{Binding KeyText}" Width="*" MinWidth="70" />
                                                <DataGridTextColumn Header="任务" Binding="{Binding JobCount}" Width="*" MinWidth="44"
                                                                    HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="张数" Binding="{Binding SheetCount}" Width="*" MinWidth="44"
                                                                    HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Header="金额" Width="*" MinWidth="72"
                                                                        HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellTextCenter}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="1"
                                                   Text="当前范围内没有数据"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,40,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=DimensionStatsGrid}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                        <!-- 统计加载遮罩：数据量大时给用户过渡（>200ms 才显示，避免闪烁） -->
                        <Border x:Name="StatsLoadingOverlay"
                                Grid.RowSpan="4"
                                Background="{DynamicResource OverlayBrush}"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="180"
                                             Height="4"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource LineBrush}" />
                                <TextBlock Text="正在统计…"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="PrintersPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="18,12" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="打印机" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="维护 IPP / Raw 9100 目标打印机" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+ 新增打印机" Style="{StaticResource PrimaryButton}" Click="AddPrinter_Click" />
                                    <Button Content="编辑" Click="EditPrinter_Click" />
                                    <Button Content="测试连接" Click="TestPrinter_Click" />
                                    <Button Content="设为默认" Click="SetDefault_Click" />
                                    <Button Content="删除" Style="{StaticResource DangerButton}" Margin="0" Click="DeletePrinter_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0,4,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="PrintersGrid" Grid.Row="0" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="PrintersGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="名称" Width="*" MinWidth="170" CellTemplate="{StaticResource PrinterNameCell}" />
                                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="230" MinWidth="161">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding Address}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="格式 / 纸张" Binding="{Binding CapabilitiesText}" Width="220" MinWidth="154">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding CapabilitiesText}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="最近测试" Width="92" MinWidth="64" CellTemplate="{StaticResource StatusPillTemplate}" />
                                        <DataGridTextColumn Header="启用" Binding="{Binding EnabledText}" Width="64" MinWidth="45" />
                                        <DataGridTextColumn Header="默认" Binding="{Binding DefaultText}" Width="64" MinWidth="45" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1"
                                           Text="测试连接会读取 IPP 打印机能力（文档格式 / 纸张 / 颜色 / 双面）。删除只移除 PrintPal 中的配置，不影响 Windows 队列。"
                                           Style="{StaticResource FooterHint}"
                                           Margin="18,8,18,2" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= routing -->
                    <Grid x:Name="RoutingPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="18,12" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="路由规则" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="优先级越小越先匹配，第一条命中的规则生效" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+ 新增规则" Style="{StaticResource PrimaryButton}" Click="AddRouting_Click" />
                                    <Button Content="编辑" Click="EditRouting_Click" />
                                    <Button Content="删除" Style="{StaticResource DangerButton}" Margin="0" Click="DeleteRouting_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0,4,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="RoutingGrid" Grid.Row="0" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="RoutingGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="70" MinWidth="49" />
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" MinWidth="126" />
                                        <DataGridTextColumn Header="匹配条件" Binding="{Binding ConditionsText}" Width="*" MinWidth="260">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding ConditionsText}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="目标打印机" Binding="{Binding TargetText}" Width="170" MinWidth="119" />
                                        <DataGridTextColumn Header="启用" Binding="{Binding EnabledText}" Width="70" MinWidth="49" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1"
                                           Text="条件按 AND 组合，同类多值按 OR；空条件表示任意。无匹配时使用默认打印机，仍无目标则标记为“未路由”。"
                                           Style="{StaticResource FooterHint}"
                                           Margin="18,8,18,2" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= prices -->
                    <Grid x:Name="PricesPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="18,12" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="价格表" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="按张计价，单位：元。双面奇数页的最后一张按单面价计算。"
                                               Style="{StaticResource SubtleText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="保存价格" Style="{StaticResource PrimaryButton}" Margin="0" Click="SavePrices_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0,4,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="PricesGrid" Grid.Row="0" MouseDoubleClick="PricesGrid_MouseDoubleClick"
                                          HorizontalScrollBarVisibility="Auto"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          AutoGenerateColumns="False"
                                          BeginningEdit="PricesGrid_BeginningEdit"
                                          PreviewKeyDown="PricesGrid_PreviewKeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="纸张" Binding="{Binding PaperDisplay}" Width="*" MinWidth="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="颜色" Binding="{Binding ColorDisplay}" Width="*" MinWidth="100" IsReadOnly="True" />
                                        <DataGridTextColumn Header="单面价 / 张" Binding="{Binding SimplexYuan, StringFormat=0.00}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="双面价 / 张" Binding="{Binding DuplexYuan, StringFormat=0.00}" Width="*" MinWidth="120" />
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="110" MinWidth="77" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" />
                                        <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="110" MinWidth="77" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1"
                                           Text="双击金额单元格即可编辑；修改后点击“保存价格”。金额按分存储、界面按元显示，未启用的规则不参与计价。"
                                           Style="{StaticResource FooterHint}"
                                           Margin="18,8,18,2" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= settings -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,4" MaxWidth="1120" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="打印服务" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="本机 IPP 地址" Style="{StaticResource LabelText}" />
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,10">
                                            <TextBlock x:Name="IppUriText" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Text="数据目录" Style="{StaticResource LabelText}" />
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,14">
                                            <TextBlock x:Name="DataDirText" Text="—" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" />
                                        </Border>
                                        <WrapPanel>
                                            <Button Content="打开数据目录" Click="OpenData_Click" Margin="0,0,8,8" />
                                            <Button Content="打开日志" Click="OpenLogs_Click" Margin="0,0,8,8" />
                                            <Button x:Name="CheckQueueButton" Content="检查队列" Click="CheckQueue_Click" Margin="0,0,8,8" />
                                            <Button Content="复制安装命令" Click="CopyInstall_Click" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
                                            <TextBlock x:Name="QueueStatusText" Text="队列状态：未检查" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="转发" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="AutoForwardCheck"
                                                  Content="捕获并计价后自动转发到路由目标"
                                                  Checked="AutoForward_Changed"
                                                  Unchecked="AutoForward_Changed" />
                                        <TextBlock Text="关闭后只捕获、计价和路由，不自动发送；之后可在收银台中人工处理。"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="选择界面主题，立即生效并记住选择"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />
                                        <TextBlock Text="浅色"
                                                   Style="{StaticResource SubtleText}"
                                                   Margin="0,0,0,6" />
                                        <WrapPanel x:Name="ThemeButtonsPanel" />
                                        <TextBlock Text="深色"
                                                   Style="{StaticResource SubtleText}"
                                                   Margin="0,10,0,6" />
                                        <WrapPanel x:Name="DarkThemeButtonsPanel" />

                                        <TextBlock Text="界面字体"
                                                   Style="{StaticResource SubtleText}"
                                                   Margin="0,14,0,6" />
                                        <ComboBox x:Name="FontFamilyBox"
                                                  Height="34"
                                                  MaxDropDownHeight="320"
                                                  ToolTip="选择本机已安装的字体，立即生效并记住选择"
                                                  SelectionChanged="FontFamilyBox_SelectionChanged" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="AutostartCheck"
                                                  Content="开机自动启动 PrintPal（当前用户）"
                                                  Checked="Autostart_Changed"
                                                  Unchecked="Autostart_Changed" />
                                        <TextBlock Text="写入 HKCU\Software\Microsoft\Windows\CurrentVersion\Run，以 --background 启动并驻留托盘。"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="44" Height="44" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="5">
                                                <Image Source="pack://application:,,,/Assets/PrintPal.png" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="VersionText" Text="PrintPal" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="本机虚拟打印 · 自动计价 · 台账归档"
                                                           Style="{StaticResource SubtleText}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="捕获 Windows IPP 打印任务，解析 PDF 页数，按纸张 / 颜色 / 单双面计价，并可转发到 IPP 或 Raw 9100 网络打印机。"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- status bar -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,0">
                    <Grid>
                        <TextBlock x:Name="StatusBarText"
                                   Text="就绪"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusVersionText"
                                   Text="PrintPal"
                                   Style="{StaticResource SubtleText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== SIMPLE -->
        <Grid x:Name="CompactLayout" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：白底 + 强分隔线；四周留 6px 露出窗口灰边，顶部圆角跟随卡片 -->
            <Border Grid.Row="0"
                    Margin="6,6,6,0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource LineStrongBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0">
                <!-- 左距 10 与账单条内边距、表头文字内边距对齐；右距 10 与结账按钮右缘对齐 -->
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="3">
                            <Image Source="pack://application:,,,/Assets/PrintPal.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="PrintPal" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="9,0,12,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CompactModeFullButton"
                                        Style="{StaticResource SmallModeSwitchButton}"
                                        Content="&#xE90C;"
                                        Tag="Full"
                                        Click="FullMode_Click"
                                        ToolTip="完整模式"
                                        AutomationProperties.Name="完整模式" />
                                <Button x:Name="CompactModeCompactButton"
                                        Style="{StaticResource SmallModeSwitchButton}"
                                        Content="&#xEA37;"
                                        Tag="Compact"
                                        Click="CompactMode_Click"
                                        ToolTip="紧凑模式"
                                        AutomationProperties.Name="紧凑模式" />
                                <Button x:Name="CompactModeMinimalButton"
                                        Style="{StaticResource SmallModeSwitchButton}"
                                        Content="&#xE73F;"
                                        Tag="Minimal"
                                        Click="MinimalMode_Click"
                                        ToolTip="极简模式"
                                        AutomationProperties.Name="极简模式" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="CompactPinButton"
                                Style="{StaticResource HeaderActionButton}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Content="&#xE718;"
                                ToolTip="置顶"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TopmostToggle_Click" />
                        <!-- 与窗口按钮组分隔：模式/置顶属“应用功能”，最小化/最大化/关闭属“窗口控制” -->
                        <Rectangle Width="1"
                                   Height="18"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource LineBrush}" />
                        <Button Style="{StaticResource WindowControlButton}"
                                Content="&#xE921;"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click"
                                ToolTip="最小化到托盘" />
                        <Button x:Name="CompactMaximizeButton"
                                Style="{StaticResource WindowControlButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click"
                                ToolTip="最大化">
                            <TextBlock x:Name="CompactMaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyph}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseToTray_Click"
                                ToolTip="隐藏到托盘" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 结账栏：白底 + 发丝线（与表头灰带、表格内容白底分层）；左右留 6px 灰边 -->
            <Border Grid.Row="1"
                    Margin="6,0,6,0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- MinWidth 给当前账单列留出余量，账单改名时列宽不再频繁跳动 -->
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompactCurrentTagText"
                               Grid.Column="0"
                               Text="客户1"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               ToolTip="双击改名"
                               MouseLeftButtonDown="BillName_MouseLeftButtonDown" />

                    <!-- 未结账单：与当前账单平行，溢出折叠 +N；左距 12 与名称左侧卡片内边距一致 -->
                    <Border x:Name="CompactParkedPanel"
                            Grid.Column="1"
                            Margin="12,0,18,0"
                            Visibility="Collapsed">
                        <!-- 左右分割线：上下各缩 2.5px（共短 5px） -->
                        <Grid>
                            <Rectangle Width="1" Fill="{DynamicResource LineBrush}" HorizontalAlignment="Left" Margin="0,2.5,0,2.5" />
                            <Rectangle Width="1" Fill="{DynamicResource LineBrush}" HorizontalAlignment="Right" Margin="0,2.5,0,2.5" />
                            <Grid x:Name="CompactParkedChipHost" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0"
                                                  x:Name="CompactParkedBills"
                                                  Margin="10,2,0,2"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ItemTemplate="{StaticResource ParkedBillChipTemplate}"
                                                  ItemsPanel="{StaticResource HorizontalChipPanel}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <Button Grid.Column="1"
                                            x:Name="CompactParkedOverflowButton"
                                            Content="+0"
                                            Style="{StaticResource ParkedOverflowChipStyle}"
                                            VerticalAlignment="Center"
                                            Margin="0,2,10,2"
                                            Visibility="Collapsed"
                                            ToolTip="查看全部账单"
                                            Click="ParkedOverflow_Click" />
                                </Grid>
                                <Popup x:Name="CompactParkedPopup"
                                       PlacementTarget="{Binding ElementName=CompactParkedOverflowButton}"
                                       Placement="Bottom"
                                       VerticalOffset="4"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Style="{StaticResource ParkedPopupCardStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="CompactParkedPopupList"
                                                          ItemTemplate="{StaticResource ParkedPopupRowTemplate}" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <!-- 金额 + 结账是收银台的视觉终点：金额放大、结账为主按钮、挂起降级为浅底次按钮 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactAmountText"
                                       Text="¥0.00"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0" />
                            <Button x:Name="CompactParkButton"
                                    Content="挂起"
                                    Style="{StaticResource SubtleButton}"
                                    Height="34"
                                    Width="76"
                                    Margin="0,0,8,0"
                                    ToolTip="把当前账单挂起，并给下一位客户开一张新账单"
                                    Click="ParkBill_Click" />
                            <Button x:Name="CompactCheckoutButton"
                                    Content="结账" Style="{StaticResource PrimaryButton}" Height="36" Width="96" Margin="0" Click="Checkout_Click" />
                        </StackPanel>
                </Grid>
            </Border>

            <!-- 表格内容区：最亮的一档（CardBrush），底部圆角跟随卡片 -->
            <Border Grid.Row="2"
                    Margin="6,0,6,6"
                    Background="{DynamicResource CardBrush}"
                    CornerRadius="0,0,6,6">
                <Grid>
                    <DataGrid x:Name="CompactCashierGrid" Margin="0" RowHeight="34" ColumnHeaderHeight="34" HorizontalScrollBarVisibility="Auto"
                              PreviewMouseRightButtonUp="JobGrid_PreviewMouseRightButtonUp"
                              ContextMenu="{StaticResource JobContextMenu}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="文档" Width="*" MinWidth="180" CellTemplate="{StaticResource JobDocumentCellCompact}" />
                            <DataGridTextColumn Header="规格" Binding="{Binding SpecText}" Width="158" MinWidth="90" />
                            <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="56" MinWidth="36" HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="份数" Binding="{Binding Copies}" Width="56" MinWidth="36" HeaderStyle="{StaticResource CenterColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- 金额右对齐：一列数字竖着扫才对得齐；表头同为右对齐 -->
                            <DataGridTemplateColumn Header="金额" Width="78" MinWidth="44" HeaderStyle="{StaticResource AmountColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountCellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="92" MinWidth="52" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" CellTemplate="{StaticResource StatusPillCenteredTemplate}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource CardBrush}" IsHitTestVisible="False" Margin="0,35,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=CompactCashierGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="等待打印任务"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="打印后会自动出现在当前账单下"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- ======================================================== MINIMAL -->
        <Border x:Name="MinimalLayout"
                Visibility="Collapsed"
                Background="{DynamicResource MinimalBackgroundBrush}"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid Background="Transparent" MouseLeftButtonDown="MinimalHeader_MouseLeftButtonDown">
                <Border x:Name="MinimalTopBar" Height="3" VerticalAlignment="Top" Background="{DynamicResource MinimalTopBarBrush}" CornerRadius="14,14,0,0" />
                <Grid Margin="16,14,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="MinimalBillNameText"
                                       Text="客户1"
                                       Foreground="{DynamicResource MinimalTextBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       MaxWidth="118"
                                       TextTrimming="CharacterEllipsis"
                                       Cursor="Hand"
                                       ToolTip="双击改名"
                                       MouseLeftButtonDown="BillName_MouseLeftButtonDown" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{DynamicResource MinimalChipBrush}"
                                BorderBrush="{DynamicResource MinimalChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="2"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MinimalModeFullButton"
                                        Style="{StaticResource DarkModeSwitchButton}"
                                        Content="&#xE90C;"
                                        Tag="Full"
                                        Click="FullMode_Click"
                                        ToolTip="完整模式"
                                        AutomationProperties.Name="完整模式" />
                                <Button x:Name="MinimalModeCompactButton"
                                        Style="{StaticResource DarkModeSwitchButton}"
                                        Content="&#xEA37;"
                                        Tag="Compact"
                                        Click="CompactMode_Click"
                                        ToolTip="紧凑模式"
                                        AutomationProperties.Name="紧凑模式" />
                                <Button x:Name="MinimalModeMinimalButton"
                                        Style="{StaticResource DarkModeSwitchButton}"
                                        Content="&#xE73F;"
                                        Tag="Minimal"
                                        Click="MinimalMode_Click"
                                        ToolTip="极简模式"
                                        AutomationProperties.Name="极简模式" />
                            </StackPanel>
                        </Border>
                            <Button x:Name="MinimalPinButton"
                                    Style="{StaticResource DarkGhostButton}"
                                    Width="26"
                                    Height="24"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Content="&#xE718;"
                                    ToolTip="置顶"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="TopmostToggle_Click" />
                            <Button Style="{StaticResource MinimalIconButton}"
                                    Width="24" Height="24"
                                    Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Margin="4,0,0,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="CloseToTray_Click"
                                    ToolTip="隐藏到托盘" />
                        </StackPanel>
                    </Grid>

                    <!-- 未结账单区：小型 chip + 溢出折叠 +N（与完整/紧凑模式同一方案，深色配色） -->
                    <Grid x:Name="MinimalParkedPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MinimalParkedCaptionText"
                                   Grid.Column="0"
                                   Text="未结账单"
                                   Foreground="{DynamicResource MinimalMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource MinimalChipBorderBrush}"
                                BorderThickness="1,0,0,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid x:Name="MinimalParkedChipHost" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0"
                                                  x:Name="MinimalParkedBills"
                                                  Margin="10,1,0,1"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ItemTemplate="{StaticResource SmallParkedBillChipTemplate}"
                                                  ItemsPanel="{StaticResource HorizontalChipPanel}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <Button Grid.Column="1"
                                            x:Name="MinimalParkedOverflowButton"
                                            Content="+0"
                                            Style="{StaticResource MinimalParkedOverflowChipStyle}"
                                            VerticalAlignment="Center"
                                            Margin="0,1,10,1"
                                            Visibility="Collapsed"
                                            ToolTip="查看全部账单"
                                            Click="ParkedOverflow_Click" />
                                </Grid>
                                <Popup x:Name="MinimalParkedPopup"
                                       PlacementTarget="{Binding ElementName=MinimalParkedOverflowButton}"
                                       Placement="Bottom"
                                       VerticalOffset="4"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Style="{StaticResource ParkedPopupCardStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="MinimalParkedPopupList"
                                                          ItemTemplate="{StaticResource ParkedPopupRowTemplate}" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="MinimalAmountText"
                               Grid.Row="2"
                               Text="¥0.00"
                               Foreground="{DynamicResource MinimalTextBrush}"
                               FontSize="34"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MinimalParkButton"
                                Grid.Column="0"
                                Content="挂起"
                                Height="34"
                                Margin="0"
                                ToolTip="把当前账单挂起，并给下一位客户开一张新账单"
                                Click="ParkBill_Click" />
                        <Button x:Name="MinimalCheckoutButton"
                                Grid.Column="2"
                                Content="结账"
                                Style="{StaticResource PrimaryButton}"
                                Height="34"
                                Margin="0"
                                Click="Checkout_Click" />
                    </Grid>

                    <!-- 极简模式打印通知：有新文件打印时在窗口下方滚动提示（文档 → 打印机 · 金额 · 状态） -->
                    <Border x:Name="MinimalPrintNotice"
                            Grid.Row="4"
                            Height="34"
                            Margin="0,8,0,0"
                            Background="{DynamicResource MinimalNoticeBackgroundBrush}"
                            BorderBrush="{DynamicResource MinimalNoticeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE767;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource MinimalNoticeForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,6,0" />
                            <Grid x:Name="MinimalPrintNoticeViewport" Grid.Column="1" ClipToBounds="True" Margin="0,0,10,0">
                                <!-- 用 StackPanel 给 TextBlock 无限宽度，保证文本按自然宽度排版；
                                     否则 TextBlock 会被 Grid 按可视区宽度测量/裁切，滚动时后半段永远露不出来。 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock x:Name="MinimalPrintNoticeText"
                                               Text=""
                                               Foreground="{DynamicResource MinimalNoticeForegroundBrush}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               RenderTransformOrigin="0,0.5">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="MinimalPrintNoticeTransform" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
            </Grid>
        </Border>
    </Grid>
</Window>


