                                             IsTabStop="False" />
                                </ScrollViewer>

                                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <StackPanel>
                                        <Button Content="转发 / 重试"
