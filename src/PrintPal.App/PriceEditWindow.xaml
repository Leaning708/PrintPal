<Window x:Class="PrintPal.App.PriceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="价格编辑"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Border Margin="12"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource PopupShadow}">
    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel Margin="2,0,36,16">
                <TextBlock Text="价格编辑" Style="{StaticResource PageTitle}" />
                <TextBlock Text="按纸张 + 颜色精确匹配的单条价格（无优先级、始终生效）" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}"
                    Width="28" Height="28" FontSize="10"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="&#xE8BB;" ToolTip="关闭" Click="Cancel_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,4,0">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="匹配条件（不可修改）" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="纸张" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="PaperText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="颜色模式" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="ColorText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="纸张与颜色是这条价格的唯一标识，如需调整请删除后重建。"
                               Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="价格" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="单面价 / 张（元）" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                            <TextBox x:Name="SimplexBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="双面价 / 张（元）" Style="{StaticResource LabelText}" Margin="0" /><TextBlock Style="{StaticResource RequiredStar}" /></StackPanel>
                            <TextBox x:Name="DuplexBox" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="0" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
