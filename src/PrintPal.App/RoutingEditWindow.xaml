<Window x:Class="PrintPal.App.RoutingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="路由规则"
        Height="720"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="规则名称" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="优先级（越小越先）" FontWeight="SemiBold" />
                <TextBox x:Name="PriorityBox" Text="100" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="目标打印机" FontWeight="SemiBold" />
                <ComboBox x:Name="TargetCombo" DisplayMemberPath="Name" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="纸张（逗号分隔，留空 = 任意）" FontWeight="SemiBold" />
            <TextBox x:Name="PaperBox" ToolTip="例如：A4,A3,Letter" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="颜色" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="MonoCheck" Content="黑白" />
                <CheckBox x:Name="ColorCheck" Content="彩色" />
            </StackPanel>
            <TextBlock Text="都不勾选 = 任意颜色" Style="{StaticResource MutedText}" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="单双面" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="SimplexCheck" Content="单面" />
                <CheckBox x:Name="LongCheck" Content="双面·长边" />
                <CheckBox x:Name="ShortCheck" Content="双面·短边" />
            </StackPanel>
            <TextBlock Text="都不勾选 = 任意" Style="{StaticResource MutedText}" />
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="最少页数（每份）" FontWeight="SemiBold" />
                <TextBox x:Name="MinPagesBox" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="最多页数（每份）" FontWeight="SemiBold" />
                <TextBox x:Name="MaxPagesBox" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6">
            <TextBlock Text="来源应用正则（可选）" FontWeight="SemiBold" />
            <TextBox x:Name="SourceAppBox" ToolTip="例如：^WPS" />
        </StackPanel>

        <StackPanel Grid.Row="7">
            <TextBlock Text="文档名正则（可选）" FontWeight="SemiBold" />
            <TextBox x:Name="DocNameBox" ToolTip="例如：report" />
        </StackPanel>

        <StackPanel Grid.Row="8">
            <CheckBox x:Name="EnabledCheck" Content="启用此规则" IsChecked="True" />
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
