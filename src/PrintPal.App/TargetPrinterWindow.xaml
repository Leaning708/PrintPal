<Window x:Class="PrintPal.App.TargetPrinterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择目标打印机"
        Width="500"
        SizeToContent="Height"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Border Margin="12"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource PopupShadow}">
    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel Margin="2,0,36,16">
                <TextBlock Text="选择目标打印机" Style="{StaticResource PageTitle}" />
                <TextBlock Text="只能选择打印能力支持该任务的打印机" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}"
                    Width="28" Height="28" FontSize="10"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="&#xE8BB;" ToolTip="关闭" Click="Cancel_Click" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="目标打印机" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="PrinterCombo" Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Style="{StaticResource InsetCard}">
                    <TextBlock x:Name="HintText" Text="选择后会按当前价格和页数转发；结果可以在打印记录的详情中查看。"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="转发" Style="{StaticResource PrimaryButton}" Margin="0" Click="Ok_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
