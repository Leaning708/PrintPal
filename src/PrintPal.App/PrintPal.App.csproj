<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PrintPal.Core\PrintPal.Core.csproj" />
    <ProjectReference Include="..\PrintPal.Ipp\PrintPal.Ipp.csproj" />
    <ProjectReference Include="..\PrintPal.Capture\PrintPal.Capture.csproj" />
    <ProjectReference Include="..\PrintPal.Storage\PrintPal.Storage.csproj" />
    <ProjectReference Include="..\PrintPal.Forwarding\PrintPal.Forwarding.csproj" />
    <ProjectReference Include="..\PrintPal.Agent\PrintPal.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PrintPal.ico" />
    <Resource Include="Assets\PrintPal.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PrintPal.App</AssemblyName>
    <RootNamespace>PrintPal.App</RootNamespace>
    <ApplicationIcon>Assets\PrintPal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms is only used for the tray icon; WPF handles DPI awareness through app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
