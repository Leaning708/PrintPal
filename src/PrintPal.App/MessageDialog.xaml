<Window x:Class="PrintPal.App.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPal"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/PrintPal.ico">

    <Border Margin="16"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource PopupShadow}">
        <Grid Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header: tone dot + title + close -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ToneDot"
                            Width="8" Height="8"
                            CornerRadius="4"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Margin="10,0,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        Width="28" Height="28"
                        FontSize="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Content="&#xE8BB;"
                        ToolTip="关闭"
                        Click="Close_Click" />
            </Grid>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="18,14,6,0"
                       FontSize="13"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource InkSecondaryBrush}" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="SecondaryButton"
                        Content="取消"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Click="Secondary_Click" />
                <Button x:Name="PrimaryButton"
                        Content="确定"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Margin="0"
                        Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
