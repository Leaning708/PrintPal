<Window x:Class="PrintPal.App.MoveJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="移到其他账单"
        Width="480"
        Height="430"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/PrintPal.ico">
    <Border Margin="12"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource PopupShadow}">
    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel Margin="2,0,36,14">
                <TextBlock Text="移到其他账单" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="DocumentText"
                           Style="{StaticResource PageSubtitle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}"
                    Width="28" Height="28" FontSize="10"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="&#xE8BB;" ToolTip="关闭" Click="Cancel_Click" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FlatCardBorder}" Padding="10">
            <ListBox x:Name="ChoiceList" BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}" Margin="0,2,0,0" Style="{StaticResource SubtleText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" />
            <Button Content="移动" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Move_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
