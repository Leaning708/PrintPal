<?xml version="1.0" encoding="utf-8"?>
<!--
  PrintPal 安装向导（中文，自绘 UI）

  页面：欢迎 → 许可 → 安装目录 → 确认 → 进度 → 完成
  - 中文单语（2026-11-06 起去掉中英双语；用户要求只保留中文）。
  - 许可文本内联，勾选「我接受」后才能下一步（LICENSEACCEPTED）。
  - 安装目录用 WIXUI_INSTALLDIR（Indirect PathEdit）指向 INSTALLFOLDER，
    Next 时 SetTargetPath；BrowseDlg 用 _BrowseProperty 回写。
  - 进度页显示当前步骤（ActionText 表，见 Package.wxs）+ 进度条 + 步骤说明。
  - 失败页显示 MSI 日志路径（MsiLogFileLocation），并可一键「打开日志」。
  - 只使用 WiX 核心元素；WixQuietExec 来自 WixToolset.Util.wixext。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <UI Id="PrintPalUI">

      <!-- ==== 字体 / 默认属性 ==== -->
      <Property Id="DefaultUIFont" Value="PrintPal_Font_Normal" />
      <TextStyle Id="PrintPal_Font_Normal" FaceName="Microsoft YaHei" Size="9" />

      <!-- InstallDirDlg 的 PathEdit 通过 Indirect 指向这个目录属性 -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

      <!-- 让 MSI 的错误对话框指向本文件里的 ErrorDlg（ICE20 要求） -->
      <Property Id="ErrorDialog" Value="ErrorDlg" />

      <!-- ============================================================
           1. 欢迎
           ============================================================ -->
      <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="ProductIcon" Type="Icon" X="20" Y="14" Width="32" Height="32" Text="PrintPalProductIcon" FixedSize="yes" IconSize="32" />
        <Control Id="Header" Type="Text" X="62" Y="20" Width="288" Height="20" Transparent="yes" NoPrefix="yes" Text="欢迎使用 PrintPal 安装程序" />
        <Control Id="Intro1" Type="Text" X="20" Y="72" Width="330" Height="14" Transparent="yes" NoPrefix="yes" Text="本向导将在这台计算机上安装 PrintPal 打印助手 [ProductVersion]。" />
        <Control Id="Intro2" Type="Text" X="20" Y="96" Width="330" Height="42" NoPrefix="yes" Text="安装内容包括：程序文件、Windows 服务 PrintPal.Service，以及名为“PrintPal Virtual Printer”的 IPP 虚拟打印队列。" />
        <Control Id="Note" Type="Text" X="20" Y="150" Width="330" Height="28" NoPrefix="yes" Text="安装需要管理员权限，整个过程约 1～2 分钟。" />
        <Control Id="VersionText" Type="Text" X="20" Y="195" Width="330" Height="14" Transparent="yes" NoPrefix="yes" Text="版本 [ProductVersion]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="NewDialog" Value="LicenseDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ============================================================
           2. 许可协议
           ============================================================ -->
      <Dialog Id="LicenseDlg" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="许可协议" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="请阅读以下条款，接受后才能继续安装。" />
        <Control Id="Body1" Type="Text" X="20" Y="50" Width="330" Height="28" NoPrefix="yes" Text="PrintPal 打印助手 版权所有 (c) 2026 PrintPal，保留所有权利。" />
        <Control Id="Body2" Type="Text" X="20" Y="82" Width="330" Height="28" NoPrefix="yes" Text="本软件供 PrintPal 打印助手配套使用，可在您拥有或负责管理的计算机上安装和使用。" />
        <Control Id="Body3" Type="Text" X="20" Y="114" Width="330" Height="42" NoPrefix="yes" Text="本软件按“原样”提供，不附带任何明示或默示的担保，包括但不限于适销性、特定用途适用性和非侵权担保。" />
        <Control Id="Body4" Type="Text" X="20" Y="160" Width="330" Height="28" NoPrefix="yes" Text="安装程序当前未签名，Windows 可能提示“未知发布者”；无需代码签名证书即可安装和使用。" />
        <Control Id="Accept" Type="CheckBox" X="20" Y="205" Width="330" Height="18" Property="LICENSEACCEPTED" CheckBoxValue="1" Text="我接受许可协议中的条款" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步" DisableCondition="LICENSEACCEPTED &lt;&gt; &quot;1&quot;" EnableCondition="LICENSEACCEPTED = &quot;1&quot;">
          <Publish Event="NewDialog" Value="InstallDirDlg" Condition="LICENSEACCEPTED = &quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ============================================================
           3. 安装位置
           ============================================================ -->
      <Dialog Id="InstallDirDlg" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="选择安装位置" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="选择 PrintPal 的安装文件夹。" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="330" Height="14" NoPrefix="yes" Text="安装文件夹：" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="85" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="110" Width="80" Height="17" Text="浏览…">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>
        <Control Id="Note" Type="Text" X="20" Y="150" Width="330" Height="56" NoPrefix="yes" Text="程序文件（含 .NET 运行时）约占 210 MB。安装会创建 Windows 服务 PrintPal.Service，并注册名为“PrintPal Virtual Printer”的打印队列。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步">
          <Publish Event="NewDialog" Value="LicenseDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ============================================================
           4. 确认安装
           ============================================================ -->
      <Dialog Id="VerifyReadyDlg" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="准备安装" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="点击“安装”开始安装 PrintPal [ProductVersion]。" />
        <Control Id="Line1" Type="Text" X="20" Y="60" Width="330" Height="14" NoPrefix="yes" Text="安装位置：[INSTALLFOLDER]" />
        <Control Id="Line2" Type="Text" X="20" Y="85" Width="330" Height="28" NoPrefix="yes" Text="将创建并启动 Windows 服务 PrintPal.Service（自动启动、LocalSystem），卸载时一并移除。" />
        <Control Id="Line3" Type="Text" X="20" Y="120" Width="330" Height="28" NoPrefix="yes" Text="将创建 IPP 打印队列“PrintPal Virtual Printer”（WSD 端口），用于捕获本机打印任务。" />
        <Control Id="Line4" Type="Text" X="20" Y="155" Width="330" Height="28" NoPrefix="yes" Text="数据保存在 C:\ProgramData\PrintPal，卸载时保留。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="安装">
          <Publish Event="EndDialog" Value="Return" Order="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ============================================================
           5. 进度：当前步骤（ActionText 表）+ 进度条 + 步骤说明
           ============================================================ -->
      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="PrintPal 安装程序" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="35" Width="330" Height="18" Transparent="yes" NoPrefix="yes" Text="正在安装 PrintPal" />
        <Control Id="SubTitle" Type="Text" X="20" Y="60" Width="330" Height="14" NoPrefix="yes" Text="请稍候，安装会自动创建服务与打印队列。" />
        <Control Id="StatusLabel" Type="Text" X="20" Y="95" Width="55" Height="10" Text="当前步骤：" />
        <Control Id="ActionText" Type="Text" X="78" Y="95" Width="275" Height="10">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="112" Width="330" Height="10" ProgressBlocks="yes" Text="安装进度">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="StepsText" Type="Text" X="20" Y="140" Width="330" Height="60" NoPrefix="yes" Text="主要步骤：校验安装条件 → 复制程序文件 → 注册并启动 Windows 服务 → 创建并验证 IPP 打印队列 → 完成。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ============================================================
           6. 完成 / 取消 / 失败
           ============================================================ -->
      <Dialog Id="ExitDialog" Width="370" Height="270" Title="PrintPal 安装程序">
        <!-- 安装/修复完成 -->
        <Control Id="TitleInstall" Type="Text" X="20" Y="45" Width="330" Height="18" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="安装完成" ShowCondition="PRINTPAL_ACTION &lt;&gt; &quot;Remove&quot;" />
        <Control Id="DescInstall" Type="Text" X="20" Y="75" Width="330" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="PrintPal [ProductVersion] 已安装完成。Windows 服务 PrintPal.Service 已启动，可从桌面或开始菜单的 PrintPal 快捷方式打开程序。" ShowCondition="PRINTPAL_ACTION &lt;&gt; &quot;Remove&quot;" />
        <Control Id="HintInstall" Type="Text" X="20" Y="140" Width="330" Height="14" NoPrefix="yes" Hidden="yes" Text="数据目录：C:\ProgramData\PrintPal" ShowCondition="PRINTPAL_ACTION &lt;&gt; &quot;Remove&quot;" />
        <!-- 卸载完成 -->
        <Control Id="TitleRemove" Type="Text" X="20" Y="45" Width="330" Height="18" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="卸载完成" ShowCondition="PRINTPAL_ACTION = &quot;Remove&quot;" />
        <Control Id="DescRemove" Type="Text" X="20" Y="75" Width="330" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="PrintPal 已从这台计算机移除。数据仍保留在 C:\ProgramData\PrintPal，可手动删除。" ShowCondition="PRINTPAL_ACTION = &quot;Remove&quot;" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- 维护页（已安装：修复 / 卸载） -->
      <Dialog Id="MaintenanceDlg" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="ProductIcon" Type="Icon" X="20" Y="14" Width="32" Height="32" Text="PrintPalProductIcon" FixedSize="yes" IconSize="32" />
        <Control Id="Header" Type="Text" X="62" Y="20" Width="288" Height="20" Transparent="yes" NoPrefix="yes" Text="维护 PrintPal" />
        <Control Id="Description" Type="Text" X="20" Y="60" Width="330" Height="40" NoPrefix="yes" Text="PrintPal [ProductVersion] 已安装在这台计算机上，可以选择修复或卸载。" />
        <Control Id="Hint" Type="Text" X="20" Y="105" Width="330" Height="46" NoPrefix="yes" Text="修复：重新注册 Windows 服务和打印队列。卸载：移除程序、服务和打印队列，C:\ProgramData\PrintPal 中的数据保留。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Repair" Type="PushButton" X="20" Y="243" Width="80" Height="17" Text="修复">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="omus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="108" Y="243" Width="80" Height="17" Text="卸载">
          <Publish Property="PRINTPAL_ACTION" Value="Remove" Order="1" />
          <Publish Property="REMOVE" Value="ALL" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- 卸载确认 -->
      <Dialog Id="RemoveDlg" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="ProductIcon" Type="Icon" X="20" Y="14" Width="32" Height="32" Text="PrintPalProductIcon" FixedSize="yes" IconSize="32" />
        <Control Id="Header" Type="Text" X="62" Y="20" Width="288" Height="20" Transparent="yes" NoPrefix="yes" Text="卸载 PrintPal" />
        <Control Id="Description" Type="Text" X="20" Y="60" Width="330" Height="30" NoPrefix="yes" Text="确定要卸载 PrintPal [ProductVersion] 吗？" />
        <Control Id="Detail" Type="Text" X="20" Y="100" Width="330" Height="60" NoPrefix="yes" Text="将删除程序文件、Windows 服务 PrintPal.Service 和打印队列“PrintPal Virtual Printer”。C:\ProgramData\PrintPal 中的数据会保留。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Remove" Type="PushButton" X="20" Y="243" Width="80" Height="17" Default="yes" Text="卸载">
          <Publish Property="PRINTPAL_ACTION" Value="Remove" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="UserExit" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="Title" Type="Text" X="20" Y="45" Width="330" Height="18" Transparent="yes" NoPrefix="yes" Text="安装已取消" />
        <Control Id="Description" Type="Text" X="20" Y="75" Width="330" Height="60" Transparent="yes" NoPrefix="yes" Text="安装程序已取消，未做任何更改。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- 失败页：日志路径放进可选中复制的 Edit，并给两个 ShellExecute 按钮 -->
      <Dialog Id="FatalError" Width="370" Height="270" Title="PrintPal 安装程序">
        <Control Id="Title" Type="Text" X="20" Y="25" Width="330" Height="18" Transparent="yes" NoPrefix="yes" Text="安装失败" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="28" Transparent="yes" NoPrefix="yes" Text="安装未能完成，安装程序已回滚到安装前的状态。" />
        <Control Id="LogLabel" Type="Text" X="20" Y="82" Width="330" Height="10" NoPrefix="yes" Text="安装日志路径（可选中后 Ctrl+C 复制）：" />
        <Control Id="LogPath" Type="Edit" X="20" Y="94" Width="330" Height="18" Property="MsiLogFileLocation" Sunken="yes" />
        <Control Id="QueueLog" Type="Text" X="20" Y="118" Width="330" Height="28" NoPrefix="yes" Text="队列/服务日志：C:\ProgramData\PrintPal\msi-queue.log" />
        <Control Id="Hint" Type="Text" X="20" Y="150" Width="330" Height="56" NoPrefix="yes" Text="失败时已尝试把日志复制到公共桌面的 PrintPal-InstallLog.txt；也可以点「打开日志文件」后另存为。把这两个日志发给我就能定位问题。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="OpenLog" Type="PushButton" X="20" Y="243" Width="82" Height="17" Text="打开日志文件">
          <Publish Event="DoAction" Value="SetOpenLogFile" Order="1" />
          <Publish Event="DoAction" Value="OpenLogFile" Order="2" Condition="MsiLogFileLocation" />
        </Control>
        <Control Id="OpenLogFolder" Type="PushButton" X="108" Y="243" Width="82" Height="17" Text="打开日志文件夹">
          <Publish Event="DoAction" Value="SetOpenLogFolder" Order="1" />
          <Publish Event="DoAction" Value="OpenLogFolder" Order="2" />
        </Control>
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- 取消确认 -->
      <Dialog Id="CancelDlg" Width="260" Height="105" Title="PrintPal 安装程序">
        <Control Id="Text" Type="Text" X="45" Y="25" Width="200" Height="26" NoPrefix="yes" Text="确定要取消安装吗？" />
        <Control Id="No" Type="PushButton" X="132" Y="72" Width="56" Height="17" Default="yes" Cancel="yes" Text="否">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Yes" Type="PushButton" X="72" Y="72" Width="56" Height="17" Text="是">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- 浏览文件夹 -->
      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="浏览文件夹">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="选择文件夹" />
        <Control Id="ComboLabel" Type="Text" X="25" Y="40" Width="50" Height="10" TabSkip="no" Text="位置:" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="80" Y="38" Width="185" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="Up" Type="PushButton" X="270" Y="38" Width="45" Height="19" ToolTip="上一级" Text="上级">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="322" Y="38" Width="45" Height="19" ToolTip="新建文件夹" Text="新建">
          <Publish Event="DirectoryListNew" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="65" Width="320" Height="120" Property="_BrowseProperty" Sunken="yes" Indirect="yes" TabSkip="no" />
        <Control Id="PathLabel" Type="Text" X="25" Y="193" Width="320" Height="10" TabSkip="no" Text="文件夹:" />
        <Control Id="PathEdit" Type="PathEdit" X="25" Y="205" Width="320" Height="18" Property="_BrowseProperty" Indirect="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes" Text="确定">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="Reset" Value="0" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- 错误对话框（MSI 在可恢复错误时显示；按钮由 MSI 按错误类型显示/隐藏） -->
      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="PrintPal 安装程序" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="15" Width="235" Height="55" TabSkip="no" NoPrefix="yes" Text="[ErrorText]" />
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="是">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="否">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="A" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="中止">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="重试">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="取消">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="忽略">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="确定">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
      </Dialog>

      <!-- 文件被占用（升级时 App/Service 正在运行会触发） -->
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="文件正在使用" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="文件正在使用" />
        <Control Id="Text" Type="Text" X="20" Y="40" Width="330" Height="40" Text="以下程序正在使用需要更新的文件。请关闭这些程序后点击“重试”，或点击“忽略”继续（可能需要重启）。" />
        <Control Id="List" Type="ListBox" X="20" Y="105" Width="330" Height="115" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Retry" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="重试">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="235" Y="243" Width="56" Height="17" Text="忽略">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="166" Y="243" Width="56" Height="17" Text="退出">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- 进度页「当前步骤」的中文文案（ActionText 表，由 MSI 在进度对话框中推送） -->
      <ProgressText Action="FindRelatedProducts" Message="检查已安装的旧版本" />
      <ProgressText Action="InstallValidate" Message="检查安装条件" />
      <ProgressText Action="InstallInitialize" Message="准备安装" />
      <ProgressText Action="ProcessComponents" Message="计算要安装的文件" />
      <ProgressText Action="InstallFiles" Message="复制程序文件" />
      <ProgressText Action="CreateShortcuts" Message="创建快捷方式" />
      <ProgressText Action="WriteRegistryValues" Message="写入注册表项" />
      <ProgressText Action="StartServices" Message="启动 Windows 服务" />
      <ProgressText Action="InstallQueue" Message="创建并验证打印队列" />
      <ProgressText Action="RegisterUser" Message="注册用户信息" />
      <ProgressText Action="RegisterProduct" Message="注册产品" />
      <ProgressText Action="PublishFeatures" Message="发布功能信息" />
      <ProgressText Action="PublishProduct" Message="发布产品信息" />
      <ProgressText Action="InstallFinalize" Message="完成安装" />
      <ProgressText Action="StopServices" Message="停止 Windows 服务" />
      <ProgressText Action="DeleteServices" Message="删除 Windows 服务" />
      <ProgressText Action="RemoveFiles" Message="删除程序文件" />
      <ProgressText Action="RemoveRegistryValues" Message="清理注册表项" />
      <ProgressText Action="RemoveShortcuts" Message="删除快捷方式" />
      <ProgressText Action="RemoveFolders" Message="删除文件夹" />
      <ProgressText Action="Rollback" Message="回滚安装" />
      <ProgressText Action="MigrateFeatureStates" Message="迁移安装状态" />

      <!-- ============================================================
           7. UI 序列
           ============================================================ -->
      <InstallUISequence>
        <!-- 首次安装走欢迎向导；已安装走维护页；REMOVE=ALL 走卸载确认 -->
        <Show Dialog="WelcomeDlg" Before="ProgressDlg" Condition="NOT Installed" />
        <Show Dialog="MaintenanceDlg" Before="ProgressDlg" Condition="Installed AND NOT REMOVE~=&quot;ALL&quot;" />
        <Show Dialog="RemoveDlg" Before="ProgressDlg" Condition="REMOVE~=&quot;ALL&quot;" />
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="FatalError" OnExit="error" />
      </InstallUISequence>

      <AdminUISequence>
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="FatalError" OnExit="error" />
      </AdminUISequence>

    </UI>
  </Fragment>
</Wix>
